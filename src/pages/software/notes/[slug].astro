---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('research')).filter((entry) => !entry.data.draft && entry.data.relatedSoftware.length > 0);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.summary}
  date={entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
  category={`${entry.data.type} / Software & Tools`}
  canonicalPath={`/software/notes/${entry.id}/`}
  backHref="/software/#notes"
  backLabel="Back to software notes"
>
  <Content />
</ArticleLayout>
