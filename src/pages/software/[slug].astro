---
import SoftwareLayout from '../../layouts/SoftwareLayout.astro';
import AeroExplorer from '../../components/AeroExplorer.astro';
import AeroStudyMeta from '../../components/AeroStudyMeta.astro';
import AeroCapabilityPapers from '../../components/AeroCapabilityPapers.astro';
import { authoritativeResult, evidence } from '../../lib/aero/nozzle-precursor';
import { softwareProjects, type SoftwareProject } from '../../data/software';

export function getStaticPaths() {
  return softwareProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: SoftwareProject }
const { project } = Astro.props;
const sections = [
  { label: 'Problem', content: project.problem },
  { label: 'Design approach', content: project.designApproach },
  { label: 'Boundaries', content: project.boundaries },
  { label: 'Evidence / verification', content: project.evidence },
  { label: 'Current limitations', content: project.limitations },
].filter(section => project.slug !== 'aero' || ['Problem', 'Design approach'].includes(section.label));
const proofStages = [
  { index: '01', label: 'Chat', title: 'Define the engineering question', detail: 'A plain-language request becomes a typed case specification. Assumptions and missing inputs remain visible.' },
  { index: '02', label: 'Math', title: 'Set expectations before solving', detail: 'First-principles checks and the live LaTeX notebook establish what the solver should be compared against.' },
  { index: '03', label: 'CAD', title: 'Inspect the current nozzle geometry', detail: 'The current CadQuery/OpenCascade manifest records the parametric nozzle, topology checks, dimensions, and source fingerprint.' },
  { index: '04', label: 'Mesh', title: 'Preflight three distinct grids', detail: 'OpenFOAM checks each generated refinement level before execution. This proof used 6,048, 9,072, and 12,600 cells.' },
  { index: '05', label: 'Solve', title: 'Run and monitor OpenFOAM', detail: 'Each rhoSimpleFoam run retained convergence, conservation, monitor, and cleanup evidence.' },
  { index: '06', label: 'Decide', title: 'Review the study', detail: 'Compare grid changes, monitor histories, and reference checks in the retained report.' },
] as const;
const pipelineFilmStages = [
  { label: 'Requirements', time: 0, detail: 'Watch a request being typed, then structured by Aero into reviewable requirements.' },
  { label: 'Math & LaTeX', time: 6.8, detail: 'Read the actual governing equations and convergence criterion before solving.' },
  { label: 'CAD', time: 11.2, detail: 'Inspect the nozzle geometry, dimensions, units, and topology.' },
  { label: 'Mesh', time: 15.2, detail: 'See the same nozzle discretized and checked before execution.' },
  { label: 'Solve', time: 19.2, detail: 'Follow residuals, conservation, and the developing pressure field.' },
  { label: 'Render', time: 23.6, detail: 'Inspect the solved field beside its evidence and engineering limits.' },
] as const;
const proofReadiness = [...evidence.numerical.gates, ...evidence.readiness.gates].map(gate => ({
  label: gate.label, status: gate.status.replaceAll('_', ' '), tone: gate.status === 'PASS' ? 'pass' : 'hold',
}));
const study = authoritativeResult.meshStudy;
const comparisons = authoritativeResult.readiness.gates.find(gate => gate.id === 'mesh_independence').detail.comparisons;
---

<SoftwareLayout
  title={project.name}
  description={project.summary}
  canonicalPath={`/software/${project.slug}/`}
  eyebrow={`Project / ${project.category}`}
  compactHeader={project.slug === 'aero'}
  hideHeader={project.slug === 'aero'}
>
  {project.slug === 'aero' && (
    <section class="content-section aero-proof" aria-labelledby="aero-proof-heading">
      <div class="section-heading proof-heading">
        <span class="section-index">01 / Engineering method</span>
        <div>
          <h1 id="aero-proof-heading">Aero's engineering method.</h1>
          <p>Trace a requirement through analytical models, geometry, numerical simulation, and reviewable evidence.</p>
          <div class="aero-private-access">
            <a class="button private-login" href="https://aegis.alex-blythe.com/aero/">Private Aero login <span aria-hidden="true">↗</span></a>
            <span>Owner access · Use your Aegis username and password.</span>
          </div>
          <nav class="aero-route-guide" aria-label="Explore Aero"><a class="button" href="#try-aero">1. Try Aero</a><a href="/software/aero/evidence/">2. See the evidence</a><a href="/software/aero/evidence/#artifacts">3. Technical details</a><a href="/software/notes/aero-source-revisions/">Download Aero revisions →</a><a href="/software/notes/rtx-3090-vs-gb10-aero-inference-benchmark/">3090 vs GB10 benchmark →</a></nav>
        </div>
      </div>

      <figure class="pipeline-film" data-pipeline-film>
        <div class="pipeline-film-screen">
          <video autoplay muted loop playsinline preload="metadata" poster="/demos/aero/pipeline-film/rev-1.3/01-requirements.png" aria-describedby="pipeline-film-caption">
            <source src="/demos/aero/pipeline-film/rev-1.3/aero-pipeline-rev-1.3.webm" type="video/webm" />
            <source src="/demos/aero/pipeline-film/rev-1.3/aero-pipeline-rev-1.3.mp4" type="video/mp4" />
          </video>
          <button class="pipeline-film-toggle" type="button" aria-label="Pause pipeline walkthrough">Pause</button>
        </div>
        <figcaption id="pipeline-film-caption">
          <div>
            <span class="pipeline-film-kicker">Illustrated workflow / 28 seconds · not a live run</span>
            <strong data-film-title>Requirements</strong>
            <p data-film-detail>Watch a request being typed, then structured by Aero into reviewable requirements.</p>
          </div>
          <ol class="pipeline-film-steps" aria-label="Jump to a pipeline stage">
            {pipelineFilmStages.map((stage, index) => (
              <li><button type="button" class:list={{ 'is-active': index === 0 }} data-film-time={stage.time}><span>0{index + 1}</span>{stage.label}</button></li>
            ))}
          </ol>
        </figcaption>
      </figure>

      <section class="aero-instance-section" id="try-aero" aria-labelledby="aero-instances-heading">
        <div class="section-heading">
          <span class="section-index">Start here</span>
          <div>
            <h2 id="aero-instances-heading">Try Aero.</h2>
            <p>Start with your engineering question. Develop the requirements and working document with Aero.</p>
            <a class="button" href="/software/aero/current/">Open Aero →</a>
            <details class="alternate-routes"><summary>More ways to use Aero</summary><a href="/software/aero/demo/">Guided demo →</a><a href="https://aegis.alex-blythe.com/aero-workspaces/">Private workspace switcher · Aegis sign-in →</a></details>
          </div>
        </div>
      </section>

      <section class="aero-live-study" aria-labelledby="channel-value-heading">
        <div><span class="eyebrow">Interactive example · 20 mL/s / 70 Pa</span><h2 id="channel-value-heading">Which channel gap meets a 70 Pa pressure-drop budget?</h2><p>At 20 mL/s through the 200 mm channel, 2.0 mm is the smallest tested gap that passes. Capability study #01 below tests a different flow and budget.</p><a class="button" href="/software/aero/current/?study=channel">Try these inputs →</a></div>
        <div class="channel-result-preview"><small>Interactive example results · 20 mL/s · water · parallel-plate model</small><table><thead><tr><th>Gap</th><th>Pressure drop</th><th>70 Pa target</th></tr></thead><tbody><tr><td>1.5 mm</td><td>142.37 Pa</td><td>Exceeds</td></tr><tr><td>2.0 mm</td><td>60.06 Pa</td><td>Meets</td></tr><tr><td>2.5 mm</td><td>30.75 Pa</td><td>Meets</td></tr></tbody></table><p>9 OpenFOAM solves · 3 grids per gap</p></div>
      </section>

      <AeroExplorer />
      <AeroCapabilityPapers />
      <section class="aero-hx-program" aria-labelledby="aero-hx-heading">
        <div class="aero-hx-copy">
          <span class="eyebrow">Heat exchanger program</span>
          <h2 id="aero-hx-heading">Failure first. Physical truth next. Transfer after.</h2>
          <p>Follow Aero's heat-exchanger evidence from the retained two-stream PCHE numerical failure to a blind, publication-grounded thermal-fluid benchmark and a separate high-temperature transfer case.</p>
        </div>
        <div class="aero-hx-status" aria-label="Heat exchanger program stages">
          <div><span>HX-01</span><strong>Failure discipline</strong><small>Real CHT evidence · numerical gates failed honestly</small></div>
          <div><span>HX-02</span><strong>Blind experiment</strong><small>Open-access PSHE input packet · reveal not yet authorized</small></div>
          <div><span>HX-03</span><strong>Engineering transfer</strong><small>Generic high-temperature screen · no employer data</small></div>
        </div>
        <a class="button" href="/software/aero/evidence/benchmarks/heat-exchanger-benchmark-program-v1/">Open the Heat Exchanger Program →</a>
      </section>
      <details class="example-library"><summary>More examples and the nozzle report</summary>
      <div class="aero-examples" aria-label="Example library">
        <a href="/software/aero/demo/?example=wall-refinement"><span class="example-art" aria-hidden="true">△ ↗ △</span><small>Recorded CFD</small><h3>Nozzle refinement</h3><p>Compare three grids and the pressure-drop evidence.</p></a>
        <a href="/software/aero/demo/?example=nozzle-first-cut-current"><span class="example-art" aria-hidden="true">Δp / Q</span><small>Same run · different review</small><h3>First-cut pressure loss</h3><p>Explore what numerical convergence does—and does not—establish.</p></a>
        <a href="/software/aero/demo/?example=cooling-channel"><span class="example-art" aria-hidden="true">Q̇ = ṁcₚΔT</span><small>Analytical screening · no CFD</small><h3>Cooling-channel sizing</h3><p>Start with an energy balance and identify missing geometry.</p></a>
      </div>
      <div class="report-strip"><div><h3>A result you can question.</h3><p>Read the retained run, its assumptions and its open validation gates.</p></div><a class="button" href="/software/aero/report/">Read sample report ↗</a></div>
      </details>

      <section class="engineering-authority" aria-labelledby="authority-heading">
        <h2 id="authority-heading">Engineering authority and limitations</h2>
        <p>Aero helps define, execute, and explain a study. Engineering conclusions must come from the stated physical model, solver or analytical calculations, and supporting checks—not the language model’s confidence. A responsible engineer reviews the inputs and intended use.</p>
        <ul>
          <li>Convergence and mesh sensitivity establish numerical behavior, not physical validation or design approval. These studies are preliminary; each report records its reference comparisons, assumptions, uncertainty, and open gates.</li>
          <li>The nozzle meshes are wall-refined. Wall-resolution suitability is not established without y+ and near-wall-model evidence. Channel results cover the stated idealized passages, not unmodeled sidewalls, fittings, or hardware.</li>
          <li>Artifact hashes establish file identity, not scientific validity. The papers are reproducible technical reports, not peer-reviewed publications.</li>
        </ul>
      </section>

      <details class="aero-disclosure" id="technical-details">
      <summary>Read the technical details <span>Nozzle checks, artifacts, and recorded gate states</span></summary>

      <div class="section-heading proof-detail-heading">
        <span class="section-index">03 / Retained proof</span>
        <div>
          <h2>Passed checks. Open questions.</h2>
          <p>Retained run: wall-refinement-v6. The values below come from its result record.</p>
        </div>
      </div>

      <ol class="proof-timeline" aria-label="Aero CFD proof workflow">
        {proofStages.map((stage) => (
          <li>
            <span class="proof-stage-index">{stage.index}</span>
            <span class="proof-stage-label">{stage.label}</span>
            <strong>{stage.title}</strong>
            <p>{stage.detail}</p>
          </li>
        ))}
      </ol>

      <div class="proof-results">
        <div class="proof-table-wrap" tabindex="0" role="region" aria-label="Three-level mesh study results">
          <div class="proof-panel-title"><span>Three-grid study</span><strong>Passed at 2% tolerance</strong></div>
          <table>
            <thead><tr><th>Grid</th><th>Cells</th><th>Pressure drop</th><th>Mesh study</th><th>Solver result</th></tr></thead>
            <tbody>
              {study.levels.map(level => <tr><th>Level {level.meshLevel}</th><td>{level.cellCount.toLocaleString('en-US')}</td><td>{level.metricValue.toFixed(3)} Pa</td><td>Eligible</td><td>{level.numericalStatus}</td></tr>)}
            </tbody>
          </table>
          <div class="proof-deltas">
            {comparisons.map(item => <div><span>{item.from} → {item.to} pressure-drop change</span><strong>{(item.relative_change * 100).toPrecision(3)}%</strong></div>)}
          </div>
        </div>

        <aside class="proof-evidence" aria-labelledby="proof-evidence-heading">
          <div class="proof-panel-title"><span id="proof-evidence-heading">Retained result</span><strong>wall-refinement-v6</strong></div>
          <dl>
            <div><dt>Completed runs</dt><dd>3 / 3</dd></div>
            <div><dt>Execution</dt><dd>{evidence.execution.status}</dd></div>
            <div><dt>Numerical gates</dt><dd>{evidence.numerical.status}</dd></div>
            <div><dt>Design readiness</dt><dd>Not established</dd></div>
            <div><dt>Runtime</dt><dd>Linux / OpenFOAM 10</dd></div>
          </dl>
          <a href="/demos/aero/wall-refinement-v6/engineering-result.json">Inspect the authoritative result <span aria-hidden="true">→</span></a>
        </aside>
      </div>

      <div class="proof-readiness">
        <div class="proof-verdict">
          <span>Engineering disposition</span>
          <strong>Preliminary first cut only</strong>
        </div>
        <div class="proof-readiness-grid">
          {proofReadiness.map((item) => (
            <div>
              <span>{item.label}</span>
              <strong class={`proof-status proof-status-${item.tone}`}>{item.status}</strong>
            </div>
          ))}
        </div>
      </div>
      </details>
      <aside class="aero-pilot"><div><span class="eyebrow">Public project boundary</span><h2>Inspect the work without submitting controlled data.</h2><p>Aero is a personal project and is not affiliated with or endorsed by any employer. Do not submit proprietary, classified, employer-owned, export-controlled, or ITAR-controlled technical information.</p></div><a class="button" href="/software/aero/evidence/">Review public evidence →</a></aside>
    </section>
  )}

  <script is:inline>
    (() => {
      const technical = document.getElementById('technical-details');
      document.querySelectorAll('a[href="#technical-details"]').forEach(link => link.addEventListener('click', () => { if (technical) technical.open = true; }));
      if (location.hash === '#technical-details' && technical) technical.open = true;
      const root = document.querySelector('[data-pipeline-film]');
      if (!root) return;
      const video = root.querySelector('video');
      const toggle = root.querySelector('.pipeline-film-toggle');
      const title = root.querySelector('[data-film-title]');
      const detail = root.querySelector('[data-film-detail]');
      const buttons = [...root.querySelectorAll('[data-film-time]')];
      const stages = [
        ['Requirements', 'Watch a request being typed, then structured by Aero into reviewable requirements.'],
        ['Math & LaTeX', 'Read the actual governing equations and convergence criterion before solving.'],
        ['CAD', 'Inspect the nozzle geometry, dimensions, units, and topology.'],
        ['Mesh', 'See the same nozzle discretized and checked before execution.'],
        ['Solve', 'Follow residuals, conservation, and the developing pressure field.'],
        ['Render', 'Inspect the solved field beside its evidence and engineering limits.'],
      ];
      const sync = () => {
        const current = video.currentTime || 0;
        let active = 0;
        buttons.forEach((button, index) => {
          if (current >= Number(button.dataset.filmTime)) active = index;
        });
        buttons.forEach((button, index) => button.classList.toggle('is-active', index === active));
        title.textContent = stages[active][0];
        detail.textContent = stages[active][1];
      };
      buttons.forEach((button) => button.addEventListener('click', () => {
        video.currentTime = Number(button.dataset.filmTime);
        video.play();
        toggle.textContent = 'Pause';
        toggle.setAttribute('aria-label', 'Pause pipeline walkthrough');
        sync();
      }));
      toggle.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          toggle.textContent = 'Pause';
          toggle.setAttribute('aria-label', 'Pause pipeline walkthrough');
        } else {
          video.pause();
          toggle.textContent = 'Play';
          toggle.setAttribute('aria-label', 'Play pipeline walkthrough');
        }
      });
      video.addEventListener('timeupdate', sync);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        video.pause();
        toggle.textContent = 'Play';
        toggle.setAttribute('aria-label', 'Play pipeline walkthrough');
      }
    })();
  </script>

  <details class:list={['technical-disclosure', { 'non-aero': project.slug !== 'aero' }]} open={project.slug !== 'aero'}>
  <summary>{project.slug === 'aero' ? 'Project background and supporting links' : 'Technical background, limitations & project artifacts'}</summary>
  <section class="content-section" aria-labelledby="project-overview">
    <div class="section-heading">
      <span class="section-index">{project.slug === 'aero' ? '04' : '01'} / Project</span>
      <div>
        <h2 id="project-overview">{project.purpose}</h2>
        <div class="page-actions"><a class="button" href="#technical-review">Technical review <span aria-hidden="true">↓</span></a>{project.slug === 'aero' && <a class="demo-link" href="/software/aero/demo/">Explore engineering demo <span aria-hidden="true">→</span></a>}{project.repository && <a class="text-link" href={project.repository}>Repository <span aria-hidden="true">↗</span></a>}</div>
      </div>
    </div>
    <div class="review-grid"><span class="review-label">Status</span><div class="review-body"><p><strong>{project.status}</strong>{project.version ? ` · ${project.version}` : ''} · {project.year}</p></div></div>
    <div class="review-grid"><span class="review-label">Technical focus</span><div class="review-body"><ul>{project.keyIdeas.map((idea) => <li>{idea}</li>)}</ul></div></div>
  </section>

  <section class="content-section" id="technical-review" aria-labelledby="technical-review-heading">
    <div class="section-heading"><span class="section-index">{project.slug === 'aero' ? '05' : '02'} / Design review</span><div><h2 id="technical-review-heading">{project.slug === 'aero' ? 'Problem and approach' : 'Capability is presented with its evidence and boundary.'}</h2>{project.slug !== 'aero' && <p>This record distinguishes what the current project can demonstrate from what remains experimental or unproven.</p>}</div></div>
    {sections.map((section) => (
      <section class="review-grid" aria-labelledby={`${project.slug}-${section.label.toLowerCase().replaceAll(' ', '-').replace('/', '-')}`}>
        <h3 class="review-label" id={`${project.slug}-${section.label.toLowerCase().replaceAll(' ', '-').replace('/', '-')}`}>{section.label}</h3>
        <div class="review-body">{section.content.length > 1 ? <ul>{section.content.map((item) => <li>{item}</li>)}</ul> : <p>{section.content[0]}</p>}</div>
      </section>
    ))}
  </section>

  <section class="content-section" aria-labelledby="artifacts-heading">
    <div class="section-heading"><span class="section-index">{project.slug === 'aero' ? '06' : '03'} / Selected artifacts</span><div><h2 id="artifacts-heading">Source, notes, and inspectable records.</h2><p>Selected references connect the project description to its public source, technical notes, and evidence records.</p></div></div>
    <div class="artifact-list">
      {project.artifacts.map((artifact) => (
        <article class="artifact-row">
          <strong>{artifact.href ? <a href={artifact.href}>{artifact.label}</a> : artifact.label}</strong>
          <p>{artifact.description}</p>
          {artifact.href && <a class="inline-link" href={artifact.href} aria-label={`Open ${artifact.label}`}>Open ↗</a>}
        </article>
      ))}
    </div>
    <div class="page-actions"><a class="button" href="/software/">← All software &amp; tools</a>{project.relatedResearch && <a class="text-link" href={project.relatedResearch.href}>{project.relatedResearch.label} ↗</a>}</div>
  </section>
  </details>
  <AeroStudyMeta label={`${project.name} public project`} />
</SoftwareLayout>

<style>
  .aero-route-guide{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin:22px 0 0}.aero-route-guide a{font-size:.85rem}.alternate-routes{margin-top:20px}.alternate-routes summary,.example-library summary{cursor:pointer;color:var(--muted);font-size:.85rem}.alternate-routes a{display:inline-block;margin:14px 20px 0 0;font-size:.85rem}.engineering-authority{margin:32px 0;padding:26px;border:1px solid var(--border);border-radius:8px}.engineering-authority h2{font-size:clamp(1.3rem,2.5vw,1.8rem);margin:0 0 14px}.engineering-authority p,.engineering-authority li{font-size:.9rem;line-height:1.75;color:var(--muted)}.engineering-authority ul{padding-left:22px;margin-bottom:0}.engineering-authority li+li{margin-top:12px}#try-aero,#technical-details{scroll-margin-top:90px}.example-library{margin:24px 0}
  .aero-live-study{display:grid;grid-template-columns:1.1fr 1fr;gap:32px;padding:28px 0;margin:20px 0;border-top:1px solid var(--border,#344449);border-bottom:1px solid var(--border,#344449)}.aero-live-study h2{font-size:clamp(25px,3vw,36px);line-height:1.2;margin:10px 0}.aero-live-study p{line-height:1.7}.aero-live-study .button{margin:8px 15px 8px 0}.channel-result-preview{border:1px solid #41606a;padding:20px;background:#12232b;color:#dcebee}.channel-result-preview small{color:#a8c2c9;font-size:11px;line-height:1.6;display:block}.channel-result-preview table{width:100%;border-collapse:collapse;margin:14px 0;font-size:14px}.channel-result-preview th,.channel-result-preview td{text-align:left;padding:10px 6px;border-bottom:1px solid #39515b}.channel-result-preview tbody tr:nth-child(2){background:#24463f}.channel-result-preview p{font-size:12px;color:#8cdbc6}@media(max-width:760px){.aero-live-study{grid-template-columns:1fr;gap:18px}}
  .aero-proof { --accent:#17818a; }
  .aero-private-access { display:flex; flex-wrap:wrap; align-items:center; gap:12px 20px; margin:24px 0 0; padding:16px 20px; border:1px solid var(--accent); border-radius:8px; background:color-mix(in srgb,var(--accent) 7%,var(--surface)); }
  .aero-private-access .private-login { display:inline-flex; justify-content:space-between; align-items:center; gap:16px; min-height:44px; padding:12px 18px; background:var(--accent); color:var(--page); font-size:1rem; font-weight:750; text-decoration:none; }
  .aero-private-access .private-login:hover { background:var(--text); }
  .aero-private-access .private-login:focus-visible { outline:3px solid var(--accent); outline-offset:4px; }
  .aero-private-access > span { color:var(--muted); font-size:.875rem; line-height:1.5; }
  @media(max-width:640px) { .aero-private-access { align-items:stretch; flex-direction:column; padding:16px; } }
  :global(html[data-theme='dark']) .aero-proof { --accent:#66d9d5; }
  .proof-heading { grid-template-columns:1fr; }
  .proof-heading>.section-index { display:none; }
  .proof-heading h1 { margin:12px 0; max-width:1000px; font-size:clamp(2.2rem,4.5vw,4.1rem); letter-spacing:-.045em; line-height:1.08; font-weight:650; }
  .aero-examples { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin:36px 0; }
  .aero-examples h3 { margin:8px 0; font-size:1.15rem; }
  .aero-examples p,.report-strip p { color:var(--muted); margin:5px 0; font-size:.9rem; }
  .aero-examples a { padding:20px; border:1px solid var(--border); border-radius:10px; transition:border-color .2s; }
  .aero-examples a:hover { border-color:var(--accent); }
  .example-art { display:flex; height:85px; align-items:center; color:var(--accent); font:italic 2rem Georgia,serif; }
  .aero-examples small { color:var(--accent); font-size:.7rem; }
  .report-strip,.aero-pilot { display:flex; align-items:center; justify-content:space-between; gap:24px; padding:24px; border:1px solid var(--border); border-radius:10px; margin:32px 0; }
  .report-strip h3 { margin:0; }
  .report-strip a,.aero-pilot a { flex-shrink:0; }
  .aero-pilot { background:color-mix(in srgb,var(--accent) 7%,var(--surface)); padding:30px; }
  .aero-pilot h2 { font-size:clamp(1.6rem,3vw,2.5rem); margin:8px 0; }
  .aero-pilot p { max-width:680px; color:var(--muted); font-size:.88rem; }
  .aero-disclosure>summary,.technical-disclosure>summary { cursor:pointer; padding:20px 0; font-weight:700; border-top:1px solid var(--border); }
  .aero-disclosure>summary span { display:block; color:var(--muted); font-size:.78rem; font-weight:400; margin-top:6px; }
