heading{padding:16px 22px;border-bottom:1px solid #314550}.pane-heading small{font-size:12px;letter-spacing:.11em;color:#83bfce}.pane-heading h1,.pane-heading h2{font-size:20px;margin:7px 0}.pane-heading p{font-size:14px;color:#bfd1dc;margin:5px 0} .conversation{flex:1;overflow:auto;padding:18px 22px}.conversation :global(article){margin:0 0 18px}.conversation :global(small){font-size:12px;color:#72cdda}.conversation :global(p){white-space:pre-wrap;margin:5px 0;font-size:15px}form{padding:12px 18px;display:grid;gap:7px}form button{justify-self:end}textarea{resize:vertical;width:100%}label{font-size:14px;display:grid;gap:6px}.inputs{display:grid;grid-template-columns:1fr 1fr;gap:15px}.confirm{display:flex;align-items:flex-start;margin:20px 0;gap:10px}.confirm input{width:18px;height:18px;flex-shrink:0}.content{padding:22px;overflow:auto;flex:1}.scope{color:#a8bbc8;font-size:13px}aside>.scope{padding:0 18px 14px}.notice{padding:10px 20px;color:#e5c26e;font-size:14px;margin:0}.primary{background:#5dd6d7!important;color:#08212b!important;border-color:#5dd6d7!important;font-weight:700}.layout-controls{display:flex;gap:15px;align-items:center;justify-content:space-between}.geometry{height:320px;margin:16px 0;background:#0e1a23;border:1px solid #314d5a;border-radius:8px;overflow:hidden}.geometry :global(canvas){width:100%;height:100%}details{margin-top:18px;border:1px solid #314550;border-radius:6px;padding:12px;font-size:14px}summary{cursor:pointer;color:#a1d8df}footer{border-top:1px solid #314550;padding:12px 20px;display:flex;justify-content:space-between;gap:8px;align-items:center}footer span{font-size:12px;color:#a8bbc8}.job{margin:18px 0;background:#1b3440;padding:15px;border-radius:7px}.job progress{display:block;width:100%;accent-color:#e3bd53;height:7px;margin-top:12px}.job[data-state=complete] progress{accent-color:#4abb98}.job[data-state=failed]{border:1px solid #ef7575}.job p{font-size:14px;margin-bottom:0}.table-scroll{overflow:auto}:global(table){border-collapse:collapse;width:100%;font-size:14px}:global(th),:global(td){padding:10px;text-align:left;border-bottom:1px solid #3c525e;white-space:nowrap}.downloads{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}:global(.katex-display){overflow:auto;padding:10px 0}:global(.result-bar){display:grid;grid-template-columns:70px 1fr 80px;gap:10px;margin:13px 0;align-items:center;font-size:14px}:global(.result-bar i){height:12px;background:#5cc9d4;border-radius:3px}:global(.result-bar[data-pass=false] i){background:#cb8260}
@media(max-width:760px){header{align-items:flex-start;padding:12px}.brand small{display:block;margin-left:0}header nav{gap:8px;font-size:12px}.stages{padding:8px;gap:4px}.stages button{display:block;padding:7px;font-size:12px}.stages button span{display:none}.stages small{display:block;font-size:10px}.workspace{display:flex;flex-direction:column;height:auto;min-height:0}aside{border-right:0;border-bottom:1px solid #486471}.conversation{max-height:240px}.work{min-height:700px}.content{overflow:visible;padding:16px}.pane-heading{padding:14px 16px}.inputs{gap:12px}.layout-controls{align-items:flex-start;flex-direction:column}.geometry{height:280px}footer{position:sticky;bottom:0;background:#11232d}.table-scroll{max-width:100%}}
</style>
