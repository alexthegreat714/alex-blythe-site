<script>
  const form = document.querySelector<HTMLFormElement>('#hx-proof-form');
  const output = document.querySelector<HTMLOutputElement>('#hx-proof-output');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !output) return;
    const data = new FormData(form);
    const v = (name: string) => Number(data.get(name));
    const p = v('pressure')*1e6, a = v('radius')/1000, b = a+v('thickness')/1000;
    const E = v('modulus')*1e9, strain = v('alpha')*1e-6*v('temperature');
    const hoop = p*(a*a+b*b)/(b*b-a*a)/1e6;
    const extension = strain*v('length')*1000;
    const stress = -E*strain/1e6;
    const reaction = Math.PI*(b*b-a*a)*E*strain/1000;
    if (![hoop, extension, stress, reaction].every(Number.isFinite)) { output.textContent = 'Invalid calculation; no result established.'; return; }
    output.textContent = `Analytical recalculation only · bore hoop stress: ${hoop.toFixed(3)} MPa · free extension: ${extension.toFixed(3)} mm · axial restrained stress: ${stress.toFixed(3)} MPa · reaction magnitude: ${reaction.toFixed(3)} kN. Hardware safety: NOT_ESTABLISHED.`;
  });
</script>
