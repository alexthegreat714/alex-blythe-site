---
import SoftwareLayout from '../../../layouts/SoftwareLayout.astro';
import AeroStudyMeta from '../../../components/AeroStudyMeta.astro';
import results from '../../../../public/demos/aero/square-body-transport-v1/accuracy-results.json';
import reference from '../../../../public/demos/aero/square-body-transport-v1/workbook-reference.json';
const base='/demos/aero/square-body-transport-v1/';
const examples=[['baseline','Baseline'],['faster','Stronger transport'],['diffusion','Pure diffusion'],['uniform','Uniform control']] as const;
const heroField=reference.baseline.values;
function fieldColor(v:number){
  const stops=[[38,104,200],[75,200,220],[225,237,183],[255,161,74],[231,61,72]];
  const scaled=Math.max(0,Math.min(1,v))*4,index=Math.min(3,Math.floor(scaled)),t=scaled-index;
  return `rgb(${stops[index].map((a,k)=>Math.round(a+(stops[index+1][k]-a)*t)).join(',')})`;
}
---
<SoftwareLayout title="CFD in Excel | A spreadsheet that simulates" description="Run a CFD teaching model in Excel: 2,501 native cell formulas, editable inputs, and a vivid scalar heatmap. Download the working workbook, four examples, and the LaTeX accuracy paper." canonicalPath="/software/aero/square-body-transport/" hideHeader>
  <div class="excel-hero">
    <div class="hero-inner">
      <nav class="hero-nav" aria-label="Project navigation"><a href="/software/aero/">← Aero / experiments</a><span>EXCEL LAB · 01</span><a href="#accuracy">Accuracy &amp; evidence ↗</a></nav>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow"><span aria-hidden="true"></span> Computational fluid dynamics, cell by cell</p>
          <h1>CFD.<br />In <span>Excel.</span></h1>
          <p class="hero-deck">Your spreadsheet is the solver.</p>
          <p class="hero-description">Change a cell. Recalculate. Watch a scalar field take shape across 2,501 formulas. A working convection–diffusion model you can open, inspect, and make your own.</p>
          <div class="hero-actions"><a class="download-primary" href={base+'Square_Body_Transport.xlsx'} download><span class="file-icon" aria-hidden="true">X</span> Get the Excel workbook <span aria-hidden="true">↓</span></a><a class="try-link" href="#experiment">Try it in your browser <span aria-hidden="true">↗</span></a></div>
          <p class="hero-footnote">.xlsx · Desktop Excel · No macros</p>
        </div>
        <figure class="sheet-showcase">
          <div class="sheet-window">
            <div class="sheet-titlebar"><span class="sheet-badge" aria-hidden="true">X</span><strong>Square_Body_Transport.xlsx</strong><span class="sheet-format">.xlsx</span></div>
            <div class="sheet-toolbar" aria-hidden="true"><span>File</span><span>Home</span><span>Formulas</span><span>Data</span><strong>Calculate</strong></div>
            <div class="formula-bar"><span>φ<sub>P</sub></span><i>ƒx</i><code>=(aW*φW+aE*φE+aN*φN+aS*φS)/aP</code></div>
            <div class="sheet-field">
              <svg viewBox="0 0 650 442" role="img" aria-labelledby="sheet-field-title sheet-field-desc">
                <title id="sheet-field-title">Computed scalar field, presented as a spreadsheet</title>
                <desc id="sheet-field-desc">Actual baseline solution on 61 by 41 nodes. Red is scalar one, blue is scalar zero. The white square fixes the scalar to zero. The formula bar shows symbolic stencil weights.</desc>
                <rect width="650" height="442" fill="#142a27" />
                {Array.from({length:13},(_,i)=><text x={52+i*47} y="17" text-anchor="middle" fill="#a7c5b7" font-size="10" font-family="monospace">{String.fromCharCode(65+i)}</text>)}
                {heroField.map((row,j)=>row.map((v,i)=><rect x={30+i*10} y={26+j*10} width="10" height="10" fill={i>=16&&i<=26&&j>=15&&j<=25?'#f4fff8':fieldColor(v)} stroke="#102826" stroke-opacity=".16" stroke-width=".5" />))}
                {heroField.filter((_,j)=>j%4===0).map((row,r)=><g><text x="17" y={34+r*40} text-anchor="middle" fill="#a7c5b7" font-size="9" font-family="monospace">{r*4+1}</text>{row.filter((_,i)=>i%5===0).map((v,c)=><text x={35+c*50} y={33+r*40} fill="#132a32" font-size="7" font-family="monospace">{v.toFixed(2)}</text>)}</g>)}
                <rect x="190" y="176" width="110" height="110" fill="#f4fff8" stroke="#112e28" stroke-width="2" />
                <text x="245" y="227" text-anchor="middle" font-size="19" fill="#145238" font-family="monospace">φ = 0</text>
                <text x="245" y="245" text-anchor="middle" font-size="9" fill="#145238" font-family="monospace">CLAMPED SQUARE</text>
              </svg>
            </div>
            <div class="sheet-tabs"><strong>Model</strong><span>Field</span><span aria-hidden="true">＋</span><small>61 × 41 nodes</small></div>
          </div>
          <figcaption><span class="preview-dot" aria-hidden="true"></span> Actual computed field · styled spreadsheet preview <span class="hero-legend">φ <i></i> 0 → 1</span></figcaption>
          <div class="formula-tag" aria-hidden="true"><span>THE ENGINE?</span><strong>Ordinary cell formulas.</strong></div>
        </figure>
      </div>
      <div class="hero-stats"><div><strong>2,501</strong><span>native cell formulas</span></div><div><strong>0</strong><span>macros or external links</span></div><div><strong>4</strong><span>documented examples</span></div><a href={base+'paper.pdf'}><span>THE MATH BEHIND THE CELLS</span><strong>Read the accuracy paper ↗</strong></a></div>
    </div>
  </div>
  <div class="transport-page">
    <AeroStudyMeta date="2026-10-24" label="CFD in Excel · workbook experiment 01" />
    <section class="workbook-story" aria-labelledby="workbook-title">
      <div class="section-top"><div><p class="kicker">01 / Open Excel. Make it move.</p><h2 id="workbook-title">From a cell edit<br />to a color field.</h2></div><p class="story-intro">The mesh is a worksheet. Each interior formula reads its neighbors. Excel repeats the calculation until the discrete transport equations settle.</p></div>
      <ol class="excel-steps"><li><span class="step-number">01</span><h3>Edit the amber cells.</h3><p>Open the <strong>Model</strong> sheet. Set velocity, diffusion, or the square’s scalar value.</p></li><li><span class="step-number">02</span><h3>Let Excel iterate.</h3><p>Enable iterative calculation: <strong>10,000 iterations</strong>, maximum change <strong>1E-10</strong>. Press <kbd>F9</kbd> to recalculate.</p></li><li><span class="step-number">03</span><h3>Follow every formula.</h3><p>Read the heatmap, then open <strong>Field</strong> to inspect the equations and residual.</p></li></ol>
      <details class="workbook-peek"><summary><span><span aria-hidden="true">▦</span> Look inside the actual workbook</span><span class="peek-hint">Inputs, equations &amp; heatmap ↓</span></summary><figure><img src="/images/aero/cfd-in-excel-workbook.png" width="1074" height="1316" loading="lazy" alt="Rendered Model worksheet with editable amber inputs, stencil coefficients, Excel calculation instructions, and the computed red-to-blue scalar heatmap." /><figcaption>Rendered preview of the downloadable workbook. The hero above uses the same computed baseline field with a presentation color palette.</figcaption></figure></details>
      <p class="scope"><strong>The CFD lesson:</strong> scalar convection–diffusion with prescribed horizontal velocity. This workbook teaches the transport discretization used in CFD. It does not solve velocity or pressure around a solid; the colored deficit is a scalar field.</p>
    </section>
    <section id="experiment" aria-labelledby="experiment-title" class="experiment">
      <div class="section-top"><div><p class="kicker">02 / Preview the workbook’s mathematics</p><h2 id="experiment-title">Test a case.<br />Then take it to Excel.</h2></div><a class="paper-link" href={base+'Square_Body_Transport.xlsx'} download>Download the working .xlsx ↓</a></div>
      <p class="experiment-intro">Explore the same discrete model here before opening the workbook. This preview runs in JavaScript; the downloaded workbook calculates with native Excel formulas.</p>
      <div class="preset-buttons" role="group" aria-label="Worked example presets">{examples.map(([id,label])=><button type="button" data-preset={id}>{label}</button>)}</div>
      <div class="lab-grid">
        <form id="transport-form">
          <label for="velocity">Horizontal velocity <span>m/s</span><input id="velocity" name="u" type="number" min="0" max="100" step="0.1" value="1" required /></label>
          <label for="diffusion">Transport coefficient Γ <span>kg/(m s)</span><input id="diffusion" name="gamma" type="number" min="0.000001" step="any" value="0.1" required /></label>
          <div class="input-pair"><label for="inlet">Inlet scalar<input id="inlet" name="inlet" type="number" step="any" value="1" required /></label><label for="square-scalar">Square scalar<input id="square-scalar" name="solid" type="number" step="any" value="0" required /></label></div>
          <label class="checkbox"><input name="enabled" id="square-enabled" type="checkbox" checked />Enable the square</label>
          <details><summary>Geometry and density</summary><div class="advanced">
            <label>Length (m)<input name="L" type="number" min="0.01" step="any" value="3" required /></label>
            <label>Height (m)<input name="H" type="number" min="0.01" step="any" value="2" required /></label>
            <label>Density (kg/m³)<input name="rho" type="number" min="0.000001" step="any" value="1" required /></label>
            <label>Square left x (m)<input name="x0" type="number" min="0.000001" step="any" value="0.8" required /></label>
            <label>Square bottom y (m)<input name="y0" type="number" min="0.000001" step="any" value="0.75" required /></label>
            <label>Square side (m)<input name="side" type="number" min="0.000001" step="any" value="0.5" required /></label>
          </div></details>
          <div class="run-actions"><button class="run" type="submit">Run model</button><button type="button" id="stop-model" disabled>Stop</button></div>
          <p class="small">61 × 41 nodes. Geometry snaps to grid nodes. Calculations run locally in your browser.</p>
        </form>
        <div class="result-panel">
          <div class="canvas-wrap"><img id="fallback-field" src={base+'examples.png'} width="1872" height="1296" alt="Four recorded scalar fields: baseline, faster transport, diffusion only, and the uniform control" /><canvas id="scalar-field" width="1000" height="700" role="img" aria-label="Calculated scalar field; numerical diagnostics and CSV download are provided below" hidden></canvas></div>
          <p id="model-status" role="status" aria-live="polite">Recorded examples are shown. Enable JavaScript to run an editable calculation.</p>
          <dl class="metrics"><div><dt>Normalized residual</dt><dd id="residual">—</dd></div><div><dt>Cell Péclet number</dt><dd id="peclet">—</dd></div><div><dt>Iterations</dt><dd id="iterations">—</dd></div><div><dt>Outlet center scalar</dt><dd id="outlet-value">—</dd></div></dl>
          <p id="field-readout" class="small">Use a pointer over the completed field to inspect a node, or download its numerical values.</p>
          <div class="result-actions"><button type="button" id="export-csv" disabled>Download calculated field (CSV)</button><a href={base+'Square_Body_Transport.xlsx'} download>Download Excel workbook</a></div>
          <p class="small" id="result-inputs">The display switches to your calculated field after a successful solve.</p>
        </div>
      </div>
      <noscript><p>The PDF, workbook, numerical evidence, and recorded examples below work without JavaScript.</p></noscript>
    </section>
    <section id="accuracy" aria-labelledby="accuracy-title">
      <p class="kicker">03 / The spreadsheet, checked</p><h2 id="accuracy-title">Big colors.<br />Inspectable numbers.</h2>
      <div class="evidence-grid"><article><h3>Solving the equations</h3><p>A separately assembled sparse LU solve agrees with the Gauss–Seidel reference within {Math.max(...Object.values(results.cases).map(r=>r.max_difference_from_workbook_reference)).toExponential(2)} scalar units across four examples. Desktop Excel was also recalculated, edited, saved, and reopened.</p></article><article><h3>Approximating the continuum</h3><p>The 1D analytical test has maximum error 0.07643 at h = 0.05, falling to 0.01120 at h = 0.00625. This is a different boundary-value problem used to check the scheme. It is not a square-case error bound.</p></article><article><h3>Representing fluid motion</h3><p>The model transports a scalar in a prescribed velocity. It does not establish pressure, no-slip flow around a solid, drag, recirculation, or vortex shedding. No experimental validation is claimed.</p></article></div>
      <p>First-order upwind adds leading streamwise numerical diffusion Γ<sub>num</sub> ≈ ρuΔx/2. For the baseline, this is 0.025 kg/(m s), or 25% of the specified Γ. <strong>That coefficient ratio is not a percentage solution error.</strong></p>
      <div class="table-scroll"><table><caption>Square-case refinement: the finest grid is a comparison, not an exact solution.</caption><thead><tr><th>Grid</th><th>Δx (m)</th><th>φ at (2,1)</th><th>φ at (3,1)</th><th>Max common-node change</th></tr></thead><tbody>{results.mesh.map(r=><tr><th scope="row">{r.nx} × {r.ny}</th><td>{r.dx.toFixed(4)}</td><td>{r.downstream_center.toFixed(6)}</td><td>{r.outlet_center.toFixed(6)}</td><td>{r.max_difference_on_common_fluid_nodes===null?'—':r.max_difference_on_common_fluid_nodes.toFixed(5)}</td></tr>)}</tbody></table></div>
      <p class="small">The maximum common-node changes of 0.04701 and 0.02721 show remaining mesh dependence. Tight solver residuals do not remove that error. Corner gradients and first-order boundary copying also affect convergence.</p>
    </section>
    <section aria-labelledby="examples-title"><p class="kicker">04 / Four experiments. One workbook.</p><h2 id="examples-title">Change the cells.<br />Compare the physics.</h2><figure><img src={base+'examples.png'} width="1872" height="1296" loading="lazy" alt="Computed scalar transport fields for the four documented cases, with fixed color limits from zero to one" /><figcaption>Independent sparse solutions on the workbook grid. Fixed 0–1 color limits allow comparisons. The white region is clamped scalar, not a solved no-slip body.</figcaption></figure>
      <div class="table-scroll"><table><caption>Recorded values at the outlet center (3 m, 1 m).</caption><thead><tr><th>Example</th><th>Velocity</th><th>Square</th><th>Outlet φ</th><th>Field data</th></tr></thead><tbody>{examples.map(([id,label])=><tr><th scope="row">{label}</th><td>{results.cases[id].parameters.u} m/s</td><td>{id==='uniform'?'Disabled':'Enabled'}</td><td>{results.cases[id].outlet_center.toFixed(6)}</td><td><a href={base+id+'.csv'} download>CSV</a></td></tr>)}</tbody></table></div>
      <p>The baseline uses a 3 m × 2 m domain, ρ = 1 kg/m³ and Γ = 0.1 kg/(m s). A 0.5 m square starts at (0.8 m, 0.75 m). Inlet scalar is 1; square scalar is 0. Visible screenshot parameters were reproduced; domain dimensions and square geometry are reconstruction assumptions.</p>
    </section>
    <section id="downloads" aria-labelledby="downloads-title"><p class="kicker">05 / Your turn</p><h2 id="downloads-title">Put CFD in your spreadsheet.</h2><p>Start with the workbook. Follow the derivation in the LaTeX paper. Reproduce the checks with the source and evidence.</p><div class="download-grid">
      <a href={base+'Square_Body_Transport.xlsx'} download><strong>Functional Excel workbook</strong><span>Editable inputs, iterative cell formulas, and scalar map.</span></a>
      <a href={base+'paper.pdf'}><strong>Accuracy and examples · PDF</strong><span>Governing equations, truncation error, measured checks, and limits.</span></a>
      <a href={base+'paper-sources.zip'} download><strong>LaTeX source and figures</strong><span>Complete source used to compile the paper.</span></a>
      <a href={base+'reproducibility.zip'} download><strong>Reproduction package</strong><span>Browser solver, independent numerical checks, CSVs, and evidence.</span></a>
      <a href={base+'accuracy-results.json'}><strong>Machine-readable accuracy results</strong><span>Analytical, sparse-solver, and mesh-refinement measurements.</span></a>
      <a href={base+'manifest.json'}><strong>Download SHA-256 manifest</strong><span>Check file identity and package integrity.</span></a>
    </div><p class="small">The workbook has no macros or external workbook links. Use desktop Excel with iterative calculation enabled: 10,000 iterations and maximum change 1E-10. Other spreadsheet engines have not been checked.</p>
    <p class="small">Teaching inspiration: the user-supplied screenshots from <a href="https://www.instagram.com/cfdbyhand/">@cfdbyhand</a>. This is an independently authored reconstruction, not the creator’s original workbook or an affiliated release. Numerical background: <a href="https://pages.nist.gov/fipy/en/3.4.5/numerical/scheme.html">NIST FiPy numerical schemes</a>.</p></section>
  </div>
</SoftwareLayout>
<script>
  const base='/demos/aero/square-body-transport-v1/';
  const form=document.querySelector<HTMLFormElement>('#transport-form')!;
  const canvas=document.querySelector<HTMLCanvasElement>('#scalar-field')!;
  const context=canvas.getContext('2d')!;
  const status=document.querySelector<HTMLElement>('#model-status')!;
  const stop=document.querySelector<HTMLButtonElement>('#stop-model')!;
  const exportButton=document.querySelector<HTMLButtonElement>('#export-csv')!;
  let worker:Worker|null=null, result:any=null;
  let plotBounds={x:65,y:42,w:900,h:600};
  const defaults={L:3,H:2,u:1,rho:1,gamma:.1,inlet:1,solid:0,x0:.8,y0:.75,side:.5,enabled:1};
  function inputs(){const p:any={};for(const k of Object.keys(defaults)){const input=form.elements.namedItem(k) as HTMLInputElement;p[k]=k==='enabled'?Number(input.checked):Number(input.value);}return p;}
  const number=(value:number)=>Number.isFinite(value)?value.toExponential(3):'unavailable';
  function color(t:number){const low=[33,102,172],mid=[247,247,247],high=[178,24,43];const a=t<.5?low:mid,b=t<.5?mid:high,z=t<.5?t*2:(t-.5)*2;return `rgb(${a.map((v,i)=>Math.round(v+(b[i]-v)*z)).join(',')})`;}
  function draw(r:any){
    const {nx,ny,p,values,mask}=r,c=context;let lo=Math.min(p.inlet,p.solid),hi=Math.max(p.inlet,p.solid);if(lo===hi)hi=lo+1;
    c.fillStyle='#FFFFFF';c.fillRect(0,0,1000,700);c.font='16px Arial';c.textAlign='left';c.fillStyle='#243746';c.fillText('Prescribed horizontal transport',65,23);
    const w=Math.min(900,600*p.L/p.H),h=w*p.H/p.L,x=65+(900-w)/2,y=42+(600-h)/2;
    plotBounds={x,y,w,h};
    for(let j=0;j<ny;j++)for(let i=0;i<nx;i++){const k=j*nx+i;c.fillStyle=mask[k]?'#FFFFFF':color(Math.max(0,Math.min(1,(values[k]-lo)/(hi-lo))));c.fillRect(x+i*w/nx,y+j*h/ny,w/nx+1,h/ny+1);}
    c.strokeStyle='#243746';c.lineWidth=1;c.strokeRect(x,y,w,h);
    c.fillStyle='#243746';for(let n=0;n<=4;n++){c.textAlign='center';c.fillText((p.L*n/4).toFixed(2),x+w*n/4,y+h+24);c.textAlign='right';c.fillText((p.H*(1-n/4)).toFixed(2),x-9,y+h*n/4+5);}
    c.textAlign='center';c.fillText('x (m)',x+w/2,688);c.save();c.translate(18,y+h/2);c.rotate(-Math.PI/2);c.fillText('y (m)',0,0);c.restore();
    c.font='14px Arial';c.textAlign='left';c.fillText(`Blue: ${lo.toFixed(3)}    Red: ${hi.toFixed(3)}    White: clamped square`,65,668);
    canvas.hidden=false;document.querySelector<HTMLImageElement>('#fallback-field')!.hidden=true;
  }
  function finish(){worker?.terminate();worker=null;stop.disabled=true;}
  async function run(){
    if(!form.reportValidity())return;
    finish();const p=inputs();status.textContent='Solving locally…';stop.disabled=false;
    try{
      worker=new Worker(base+'worker.mjs',{type:'module'});
      worker.onerror=()=>{status.textContent='The calculation could not start. The recorded examples and downloads remain available.';finish();};
      worker.onmessage=({data})=>{
        if(data.type==='progress'){status.textContent=`Solving: ${data.iterations.toLocaleString()} sweeps; latest maximum change ${number(data.change)}.`;return;}
        if(data.type==='error'){status.textContent=data.message+' Any displayed field is the previous completed result.';finish();return;}
        result=data;draw(data);exportButton.disabled=false;
        document.querySelector('#residual')!.textContent=number(data.metrics.residual);
        document.querySelector('#peclet')!.textContent=data.c.Pe.toFixed(3);
        document.querySelector('#iterations')!.textContent=data.iterations.toLocaleString();
        document.querySelector('#outlet-value')!.textContent=data.metrics.outletCenter.toFixed(6);
        document.querySelector('#result-inputs')!.textContent=`Completed inputs: u = ${data.p.u} m/s, Γ = ${data.p.gamma} kg/(m s), ρ = ${data.p.rho} kg/m³, L × H = ${data.p.L} × ${data.p.H} m. Square ${data.p.enabled?'enabled':'disabled'}.`;
        status.textContent='Converged discrete scalar solution. Residual is a numerical check, not physical validation.';finish();
      };worker.postMessage({parameters:p});
    }catch(e){status.textContent='Your browser could not run the local worker. Use the workbook or recorded examples.';finish();}
  }
  form.addEventListener('submit',e=>{e.preventDefault();run();});
  form.addEventListener('input',()=>{finish();status.textContent='Inputs changed. Run the model to update the field. Any displayed values belong to the previous completed run.';});
  stop.addEventListener('click',()=>{finish();status.textContent='Calculation stopped. Any displayed field is the previous completed result.';});
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(button=>button.addEventListener('click',()=>{
    const p={...defaults};if(button.dataset.preset==='faster')p.u=2;if(button.dataset.preset==='diffusion')p.u=0;if(button.dataset.preset==='uniform')p.enabled=0;
    for(const [key,value] of Object.entries(p)){const el=form.elements.namedItem(key) as HTMLInputElement;if(key==='enabled')el.checked=Boolean(value);else el.value=String(value);}run();
  }));
  exportButton.addEventListener('click',()=>{
    if(!result)return;const r=result,rows=['x_m,y_m,phi,clamped_square'];
    for(let j=0;j<r.ny;j++)for(let i=0;i<r.nx;i++){const k=j*r.nx+i;rows.push([i*r.c.dx,r.p.H-j*r.c.dy,r.values[k],r.mask[k]].join(','));}
    const url=URL.createObjectURL(new Blob([rows.join('\n')],{type:'text/csv'}));const a=document.createElement('a');a.href=url;a.download='scalar-field.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
  });
  canvas.addEventListener('pointermove',e=>{
    if(!result)return;const box=canvas.getBoundingClientRect(),px=(e.clientX-box.left)*1000/box.width,py=(e.clientY-box.top)*700/box.height;
    const {x,y,w,h}=plotBounds;if(px<x||px>=x+w||py<y||py>=y+h)return;
    const i=Math.floor((px-x)/w*result.nx),j=Math.floor((py-y)/h*result.ny),k=j*result.nx+i;
    document.querySelector('#field-readout')!.textContent=`Node: x = ${(i*result.c.dx).toFixed(3)} m, y = ${(result.p.H-j*result.c.dy).toFixed(3)} m, φ = ${result.values[k].toFixed(6)}${result.mask[k]?' (clamped square)':''}.`;
  });
  window.addEventListener('pagehide',finish);run();
</script>
