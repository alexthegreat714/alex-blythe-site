---
import SoftwareLayout from '../../../../layouts/SoftwareLayout.astro';
import {
  evidence, monitors, artifacts, resultFields, demoRoot, telemetry,
  publicCadArtifact, publicPressureField,
} from '../../../../lib/aero/nozzle-precursor';
import { sections, firstOrder, mathml } from '../../../../lib/aero/notebook';
import {
  analysisSteps, firstOrderInputs, firstOrderValues, latexDocument,
} from '../../../../lib/aero/analysis';
import { PROVENANCE_LABEL, STATUS_LABEL } from '../../../../lib/aero/case';

const runMode = 'RECORDED';
const solver = 'OpenFOAM / rhoSimpleFoam';

// Runtime is shown only when it was actually measured for the phase.
const solverRuntime = evidence.execution.solverSeconds;
const totalRuntime = evidence.execution.totalSeconds;
const fmtRuntime = (v: number | null) => (typeof v === 'number' ? `${v.toFixed(2)} s` : 'NOT RECORDED');

const statusClass = (s: string) =>
  s === 'PASS' || s === 'READY' ? 'ok' : s === 'FAIL' || s === 'NOT_READY' ? 'bad' : 'unknown';

const clientState = {
  runId: 'aero-wall-refinement-v6',
  mode: runMode,
  artifacts,
  resultFields: resultFields.map((f) => ({ field: f.field, label: f.label })),
  publicCadArtifact,
  publicPressureField,
  telemetry: `${demoRoot}/telemetry.json`,
  recordedTelemetry: telemetry,
  analysis: { inputs: firstOrderInputs, values: firstOrderValues },
  localApi: 'http://127.0.0.1:5213',
};
const demoCases = [
  {
    id: 'wall-refinement',
    title: 'Three-grid nozzle refinement',
    kind: 'Recorded OpenFOAM family',
    question: 'Is the reported nozzle result stable as the mesh is refined?',
    summary: 'Three completed grids retain mesh checks, solver telemetry, conservation gates, and hashed result artifacts.',
    disposition: 'Numerically independent at the declared 2% gate; external validation is still required.',
    evidenceHref: '/demos/aero/wall-refinement-v6/engineering-result.json',
    evidenceLabel: 'Open acceptance summary',
    prompt: 'Walk me through the recorded nozzle mesh study with 6,048, 9,072, and 12,600 cells and a 2% pressure-drop acceptance limit.',
    requirements: {
      goal: 'Establish numerical mesh independence before interpreting the nozzle result',
      geometry: 'Parametric converging-diverging nozzle / three grid levels',
      operating: 'Compressible air / steady RANS / matched boundary conditions',
      evidence: 'Adjacent-grid change ≤ 2%, convergence, conservation, hashed artifacts',
    },
    stages: [100, 100, 100, 100, 100, 100],
  },
  {
    id: 'nozzle-first-cut-current',
    title: 'First-cut nozzle review',
    kind: 'Same retained OpenFOAM run / alternate question',
    question: 'What can the current numerically converged nozzle run establish—and what remains blocked?',
    summary: 'This view uses the same current wall-resolved nozzle evidence as the mesh-study example, but focuses on the boundary between numerical acceptability and engineering readiness.',
    disposition: 'Numerical and mesh-independence gates pass; validation and model-fidelity evidence remain open.',
    evidenceHref: '/demos/aero/wall-refinement-v6/engineering-result.json',
    evidenceLabel: 'Open current evidence',
    prompt: 'Review the current wall-resolved nozzle run. Explain what the 6,048 / 9,072 / 12,600-cell study proves and what it does not prove.',
    requirements: {
      goal: 'Produce a bounded first-cut compressible nozzle result',
      geometry: '20 / 8 / 24 mm inlet, throat, and exit radii; 45 / 110 mm lengths',
      operating: 'Air / 0.010 kg/s / steady compressible precursor',
      evidence: 'Pre-solve screen, mesh checks, convergence, conservation, field artifact',
    },
    stages: [100, 100, 100, 100, 100, 100],
  },
  {
    id: 'cooling-channel',
    title: 'Cooling-channel screening',
    kind: 'Analytical walkthrough',
    question: 'Can a rectangular water channel remove 8 kW while controlling pressure drop and temperature?',
    summary: 'Requirements and correlation-based screening are defined. CAD, mesh, CFD execution, and test correlation remain deliberately incomplete.',
    disposition: 'Screening only; CFD and experimental correlation are required before design use.',
    evidenceHref: '',
    evidenceLabel: '',
    prompt: 'Screen a rectangular water-cooling channel for 8 kW heat removal while limiting bulk temperature rise and pressure drop. Tell me what geometry and operating data are still missing before CFD.',
    requirements: {
      goal: 'Screen 8 kW heat removal and pressure-drop feasibility',
      geometry: 'Rectangular channel / dimensions still required',
      operating: 'Liquid water / heat load known / flow state incomplete',
      evidence: 'Energy balance and correlation screen defined; CFD and test correlation missing',
    },
    stages: [100, 100, 35, 0, 0, 0],
  },
];
---

<SoftwareLayout
  title="Aero / Guided demo"
  description="An interactive engineering workbench over a recorded OpenFOAM run: notebook, model viewport, conversation, and the evidence that decides what the result establishes."
  canonicalPath="/software/aero/demo/"
  eyebrow="Aero / Engineering workbench"
  hideHeader={true}
>
  <section class="guided-demo" data-guided-demo aria-labelledby="guided-demo-title">
    <header class="guided-topbar">
      <a class="guided-brand" href="/software/aero/"><span>AERO</span><small>Public demo</small></a>
      <ol class="guided-stages" aria-label="Aero workflow stages">
        {['Requirements', 'Math', 'CAD', 'Mesh', 'Solve', 'Render'].map((label, index) => (
          <li class:list={{ 'is-active': index === 0 }} data-guided-stage={index}>
            <button type="button"><span>0{index + 1}</span><b>{label}</b><small>{index === 0 ? 'Ready for input' : 'Waiting on requirements'}</small><i></i></button>
          </li>
        ))}
      </ol>
    </header>

    <div class="guided-body">
      <aside class="guided-rail" aria-label="Aero tools">
        <div><strong>Aero</strong><span>Engineering workflow</span></div>
        <button class="is-active" type="button">Workflow</button>
        <button type="button" data-open-detail="analysis">Math &amp; LaTeX</button>
        <button type="button" data-open-detail="geometry">CAD &amp; tolerances</button>
        <button type="button" data-open-detail="mesh">Mesh &amp; specs</button>
        <button type="button" data-open-detail="evidence">Runs &amp; evidence</button>
        <p><b>Guided demo</b> No VM or solver access</p>
      </aside>

      <main class="guided-main">
        <div class="guided-scene-head">
          <div><span>Interactive demo</span><h1 id="guided-demo-title">A CFD case, one step at a time.</h1></div>
          <p>Choose an example. Press Play. Let Aero guide you.</p>
        </div>

        <div class="guided-examples" aria-label="Load a guided example">
          <span>Try an example</span>
          {demoCases.map((item, index) => (
            <button type="button" data-demo-case={item.id} aria-pressed="false"><b>0{index + 1}</b>{item.title}</button>
          ))}
          <button type="button" data-new-case>Blank case</button>
        </div>

        <section class="demo-player" aria-label="Guided demo player">
          <div class="demo-player-head"><span data-tour-counter>6 steps · At your pace</span><span>Scripted Aero guide · Recorded results</span></div>
          <div class="demo-scene" data-tour-scene>
            <div class="demo-scene-copy" data-tour-copy>
              <span data-tour-kicker>Requirements → Math → CAD → Mesh → Solve → Render</span>
              <h2 data-tour-title>See how Aero turns a question into a CFD workflow.</h2>
              <p data-tour-summary>Start with the nozzle example, or choose another above.</p>
            </div>
            <div class="demo-tour-model" data-tour-model hidden aria-label="Interactive demonstration model"></div>
            <div class="demo-tour-math" data-tour-math hidden>
              <math display="block"><mrow><mover><mi>m</mi><mo>˙</mo></mover><mo>=</mo><mi>ρ</mi><mi>A</mi><mi>V</mi></mrow></math>
              <p>Mass flow = density × area × velocity</p>
              <p>For this nozzle: 0.010 kg/s → 6.762 m/s at the inlet.</p>
            </div>
            <div class="demo-tour-charts" data-tour-charts hidden></div>
          </div>
          <div class="demo-narration" aria-live="polite"><b>Aero</b><p data-tour-narration>Press Play and I’ll explain each step. You choose when to continue.</p></div>
          <div class="demo-player-controls">
            <button type="button" data-tour-back disabled>← Back</button>
            <button type="button" data-tour-play>▶ Play demo</button>
            <button type="button" data-tour-next disabled>Next step →</button>
          </div>
        </section>

        <details class="demo-extra" data-tour-questions>
          <summary>Ask Aero a question or try a change</summary>
        <div class="guided-grid">
          <section class="guided-conversation" aria-labelledby="guided-conversation-title">
            <div class="guided-panel-head"><h2 id="guided-conversation-title">Requirements conversation</h2><span>Interactive demo guide</span></div>
            <div class="guided-log" data-guided-log aria-live="polite">
              <div class="guided-turn guided-aero"><b>Aero</b><p>Describe the engineering decision you need to make. I’ll separate known inputs, assumptions, missing data, success criteria, and what must remain blocked.</p></div>
            </div>
            <div class="guided-questions">
              <button type="button" data-guided-question="What information do you still need?">What do you still need?</button>
              <button type="button" data-guided-question="Why is validation separate from convergence?">Why isn’t convergence enough?</button>
              <button type="button" data-guided-question="Change the throat radius to 10 mm.">Try a design change</button>
            </div>
            <form class="guided-composer" data-guided-form>
              <label for="guided-message">Engineering request or question</label>
              <div><textarea id="guided-message" data-guided-message rows="3" maxlength="900" placeholder="Example: Walk me through a first-cut compressible nozzle CFD case…"></textarea><button type="submit">Send</button></div>
              <small>This public demo uses a bounded Aero guide over curated cases. It can explain and revise the case record; it cannot start a private solver.</small>
            </form>
          </section>

          <aside class="guided-record" aria-labelledby="guided-record-title">
            <div class="guided-panel-head"><h2 id="guided-record-title">Requirement record</h2><span data-guided-case-label>New case</span></div>
            <dl>
              <div><dt>Engineering goal</dt><dd data-record="goal">Awaiting conversation</dd></div>
              <div><dt>Geometry</dt><dd data-record="geometry">Awaiting dimensions or CAD</dd></div>
              <div><dt>Operating state</dt><dd data-record="operating">Awaiting fluid inputs</dd></div>
              <div><dt>Evidence plan</dt><dd data-record="evidence">Awaiting success criteria</dd></div>
              <div><dt>Execution gate</dt><dd data-record="gate">Blocked</dd></div>
            </dl>
            <div class="guided-readiness"><span><b data-guided-progress-label>Requirements 0%</b><small>Ready for the next stage only at 100%</small></span><div role="progressbar" aria-label="Requirements readiness" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-guided-progress><i></i></div></div>
            <button type="button" class="guided-continue" data-guided-continue disabled>Continue to detailed walkthrough <span>→</span></button>
          </aside>
        </div>
        </details>
      </main>
    </div>
    <script id="demo-case-data" type="application/json" is:inline set:html={JSON.stringify(demoCases)} />
  </section>

  <details class="demo-extra demo-evidence" id="demo-evidence">
  <summary>Inspect the full math, case data and evidence</summary>
  <section class="workbench-intro content-section">
    <p class="section-index" id="wb-mode-label">Detailed walkthrough / Recorded evidence</p>
    <div><h2 id="wb-title">Inspect each engineering stage and ask why it passed—or why it remains blocked.</h2><p id="wb-mode-description">The retained nozzle case below exposes the equations, geometry, mesh, solver telemetry, rendered field, and evidence gates behind the short guided experience.</p></div>
  </section>

  <div class="workbench" id="workbench" data-state={JSON.stringify(clientState)}>
    <header class="wb-bar">
      <span class="wb-brand">AERO</span>
      <span class="wb-title">Engineering workbench</span>
      <span class="wb-meta">
          <span class="wb-mode" id="run-mode" data-mode={runMode}>{runMode} RUN</span>
          <span class="wb-status" id="run-status">{evidence.execution.status}</span>
        <span class="wb-solver">{solver}</span>
      </span>
    </header>

    <!-- mobile tab bar; hidden on desktop -->
    <nav class="wb-tabs" aria-label="Workbench sections">
      <button type="button" class="wb-tab is-active" data-tab="notebook" aria-selected="true">Notebook</button>
      <button type="button" class="wb-tab" data-tab="analysis" aria-selected="false">Math</button>
      <button type="button" class="wb-tab" data-tab="viewport" aria-selected="false">Model</button>
      <button type="button" class="wb-tab" data-tab="evidence" aria-selected="false">Evidence</button>
      <button type="button" class="wb-tab" data-tab="chat" aria-selected="false">Chat</button>
    </nav>

    <div class="wb-grid">
      <!-- ============================= NOTEBOOK ============================ -->
      <section class="wb-pane wb-notebook is-active" data-pane="notebook" aria-labelledby="nb-h">
        <h3 class="wb-pane-title" id="nb-h">Engineering notebook</h3>
        <div class="nb-scroll">
          {sections.map((s) => (
            <section class="nb-section" id={`nb-${s.id}`} tabindex="-1">
              <h4><span class="nb-index">{s.index}</span> {s.title}</h4>

              {s.body?.map((p) => <p>{p}</p>)}

              {s.values && (
                <dl class="nb-values">
                  {s.values.map((v) => (
                    <div class="nb-value">
                      <dt>{v.label}</dt>
                      <dd>
                        <span class="nb-num">{v.value}{v.units ? ` ${v.units}` : ''}</span>
                        <span class="prov" data-prov={v.source}>{PROVENANCE_LABEL[v.source]}</span>
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              {s.equations?.map((eq) => (
                <figure class="eqn">
                  <figcaption>{eq.title}</figcaption>
                  <div class="eqn-math" set:html={mathml(eq)} />
                  <dl class="eqn-symbols">
                    {eq.symbols.map((sym) => (
                      <div>
                        <dt>{sym.symbol}</dt>
                        <dd>{sym.meaning}{sym.units ? ` (${sym.units})` : ''}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="eqn-meaning">{eq.meaning}</p>
                  <span class="prov" data-prov={eq.source}>{PROVENANCE_LABEL[eq.source]}</span>
                </figure>
              ))}

              {s.id === 'first-order' && (
                <div class="fo">
                  {s.notEstablished && <p class="nb-note">{s.notEstablished}</p>}
                  <ol class="fo-chain">
                    <li>
                      <span class="fo-step">Inputs</span>
                      <ul>
                        {firstOrder.inputs.map((i) => (
                          <li>{i.label}: <b>{i.value}</b> <span class="prov" data-prov={i.source}>{PROVENANCE_LABEL[i.source]}</span></li>
                        ))}
                      </ul>
                    </li>
                    <li>
                      <span class="fo-step">Equation</span>
                      {firstOrder.equation && <div class="eqn-math" set:html={mathml(firstOrder.equation)} />}
                    </li>
                    <li>
                      <span class="fo-step">Analytical estimate</span>
                      <p class="fo-missing">{firstOrder.estimate ? `${firstOrder.estimate.value}${firstOrder.estimate.units ? ` ${firstOrder.estimate.units}` : ''}` : 'NOT YET ESTABLISHED'}</p>
                    </li>
                    <li>
                      <span class="fo-step">Expected trend</span>
                      <p>{firstOrder.expectedTrend}</p>
                    </li>
                    <li>
                      <span class="fo-step">Numerical result</span>
                      <p class={firstOrder.numericalResult ? '' : 'fo-missing'}>{firstOrder.numericalResult ? `${firstOrder.numericalResult.label}: ${firstOrder.numericalResult.value}` : 'NOT YET ESTABLISHED'}</p>
                    </li>
                    <li>
                      <span class="fo-step">Comparison</span>
                      <p class="fo-missing">{firstOrder.comparison ? firstOrder.comparison.value : 'NOT YET ESTABLISHED'}</p>
                    </li>
                  </ol>
                </div>
              )}
            </section>
          ))}
        </div>
      </section>

      <!-- ======================= ANALYTICAL WORKSPACE ===================== -->
      <section class="wb-pane wb-analysis" data-pane="analysis" aria-labelledby="an-h">
        <div class="an-head">
          <div>
            <h3 class="wb-pane-title" id="an-h">Pre-solve analytical workspace</h3>
            <p>First-principles expectations from case inputs, established before OpenFOAM executes.</p>
          </div>
          <div class="an-head-actions">
            <span class="an-status">ANALYTICAL / PRE-RUN</span>
            <div class="an-view-switch" role="group" aria-label="Analytical document view">
              <button type="button" class="is-active" data-analysis-view="render" aria-pressed="true">Rendered</button>
              <button type="button" data-analysis-view="source" aria-pressed="false">LaTeX source</button>
            </div>
          </div>
        </div>

        <div class="an-shell" data-analysis-panel="render">
          <nav class="an-index" aria-label="First-order derivation steps">
            {analysisSteps.map((step, index) => (
              <button type="button" class={index === 0 ? 'is-active' : ''} data-analysis-target={step.id} aria-current={index === 0 ? 'step' : undefined}>
                <span>{step.index}</span>{step.title}
              </button>
            ))}
          </nav>

          <article class="an-document" aria-live="polite">
            <header class="an-document-head">
              <div>
                <span>CASE / NOZZLE-WALL-REFINEMENT-V6</span>
                <h4>First-order flow screening</h4>
              </div>
              <span class="prov" data-prov="ANALYTICAL">{PROVENANCE_LABEL.ANALYTICAL}</span>
            </header>

            <dl class="an-inputs" aria-label="Analytical inputs">
              <div><dt>ṁ</dt><dd><span data-analysis-input="massFlowKgS">{firstOrderInputs.massFlowKgS.toFixed(3)}</span> kg/s</dd></div>
              <div><dt>p<sub>ref</sub></dt><dd>{firstOrderInputs.referencePressurePa} Pa</dd></div>
              <div><dt>T<sub>ref</sub></dt><dd>{firstOrderInputs.referenceTemperatureK} K</dd></div>
              <div><dt>r<sub>i</sub></dt><dd>{(firstOrderInputs.inletRadiusM * 1000).toFixed(0)} mm</dd></div>
              <div><dt>R</dt><dd>{firstOrderInputs.gasConstantJkgK} J/(kg K)</dd></div>
              <div><dt>γ</dt><dd>{firstOrderInputs.heatCapacityRatio}</dd></div>
            </dl>

            <div class="an-steps">
              {analysisSteps.map((step) => (
                <section class="an-step" id={`analysis-${step.id}`} data-analysis-step={step.id} tabindex="-1">
                  <header><span>{step.index}</span><h5>{step.title}</h5></header>
                  <div class="an-equation" set:html={step.mathml} />
                  <code class="an-inline-source">{step.latex}</code>
                  <p>{step.explanation}</p>
                  {step.resultKey && (
                    <div class="an-result">
                      <span>{step.resultLabel}</span>
                      <b><span data-analysis-value={step.resultKey}>{
                        step.resultKey === 'areaM2' ? firstOrderValues.areaM2.toExponential(4)
                          : step.resultKey === 'densityKgM3' ? firstOrderValues.densityKgM3.toFixed(4)
                          : step.resultKey === 'velocityMS' ? firstOrderValues.velocityMS.toFixed(3)
                          : step.resultKey === 'mach' ? firstOrderValues.mach.toFixed(5)
                          : firstOrderValues.dynamicPressurePa.toFixed(2)
                      }</span>{step.units ? ` ${step.units}` : ''}</b>
                    </div>
                  )}
                  {step.id === 'mach' && (
                    <div class="an-result an-result-secondary">
                      <span>Reference speed of sound</span>
                      <b><span data-analysis-value="speedOfSoundMS">{firstOrderValues.speedOfSoundMS.toFixed(2)}</span> m/s</b>
                    </div>
                  )}
                </section>
              ))}
            </div>

            <aside class="an-trend">
              <b>Expected before solving</b>
              <p>At fixed reference state and geometry, V and M scale linearly with ṁ; q scales approximately with ṁ².</p>
              <p><strong>Independent nozzle pressure drop:</strong> NOT YET ESTABLISHED.</p>
            </aside>

            <form class="an-question" id="analysis-question">
              <label for="analysis-query">Ask the derivation</label>
              <div><input id="analysis-query" type="text" maxlength="160" placeholder="Why is the inlet Mach number small?" /><button type="submit">Find the math</button></div>
              <small>Questions select the relevant structured derivation; they do not generate equations from solver output.</small>
            </form>
          </article>
        </div>

        <div class="an-source" data-analysis-panel="source" hidden>
          <div class="an-source-head"><span>first-order-screening.tex</span><span>READ ONLY / GENERATED FROM CASE STATE</span></div>
          <pre><code>{latexDocument}</code></pre>
        </div>
      </section>

      <!-- ============================= VIEWPORT ============================ -->
      <section class="wb-pane wb-viewport" data-pane="viewport" aria-labelledby="vp-h">
        <div class="vp-head">
          <h3 class="wb-pane-title" id="vp-h">Engineering viewport</h3>
          <div class="vp-modes" role="group" aria-label="Viewport stage">
            <button type="button" class="vp-mode is-active" data-mode="geometry">Geometry</button>
            <button type="button" class="vp-mode" data-mode="mesh">Mesh</button>
            <button type="button" class="vp-mode" data-mode="result">Result</button>
          </div>
        </div>

        <div class="vp-stage" id="vp-stage" tabindex="0" role="group"
             aria-label="Engineering model viewport. Drag to orbit, right drag to pan, plus and minus to zoom, zero to reset.">
          <img id="vp-image" src={artifacts.geometry} alt="Wall-resolved axisymmetric nozzle geometry" draggable="false" />
          <div id="vp-scientific" class="vp-scientific" hidden aria-label="Interactive OpenFOAM pressure field"></div>
          <div id="vp-legend" class="vp-legend" hidden>
            <span id="vp-legend-max"></span><span class="vp-legend-bar" aria-hidden="true"></span><span id="vp-legend-min"></span>
            <b>Pressure / Pa</b><small>SOLVER OUTPUT</small>
          </div>
        </div>

        <div class="vp-controls">
          <button type="button" data-vp="zoom-in" aria-label="Zoom in">+</button>
          <button type="button" data-vp="zoom-out" aria-label="Zoom out">−</button>
          <button type="button" data-vp="reset">Reset view</button>
          <button type="button" data-vp="mesh">Mesh view</button>
          <span class="vp-hint" id="vp-hint">Geometry — drag to pan, scroll to zoom</span>
        </div>

        <div class="vp-fields">
          <span class="vp-fields-label">Result fields</span>
          {resultFields.length === 0 ? (
            <p class="vp-none">
              NOT YET ESTABLISHED — no static scalar field is presented. After an approved local run,
              the actual OpenFOAM pressure artifact is loaded here as SOLVER OUTPUT.
            </p>
          ) : (
            <div class="vp-field-buttons">
              {resultFields.map((f) => (
                <button type="button" class="vp-field" data-field={f.field}>{f.label}</button>
              ))}
            </div>
          )}
        </div>

        <details class="vp-monitors">
          <summary>Final engineering monitors ({monitors.length})</summary>
          <dl>
            {monitors.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}{m.units ? ` ${m.units}` : ''}</dd>
              </div>
            ))}
          </dl>
          <span class="prov" data-prov="SOLVER_OUTPUT">{PROVENANCE_LABEL.SOLVER_OUTPUT}</span>
        </details>
        <section class="telemetry" aria-labelledby="telemetry-h">
          <h4 id="telemetry-h">Real solver telemetry</h4>
          <div class="telemetry-grid">
            <figure data-chart="residuals"><figcaption>Residual convergence</figcaption><div class="chart-body"></div></figure>
            <figure data-chart="mass"><figcaption>Mass conservation</figcaption><div class="chart-body"></div></figure>
            <figure data-chart="energy"><figcaption>Energy conservation</figcaption><div class="chart-body"></div></figure>
            <figure data-chart="monitor"><figcaption>Outlet mass-flow monitor</figcaption><div class="chart-body"></div></figure>
          </div>
        </section>
      </section>

      <!-- ============================== CHAT =============================== -->
      <section class="wb-pane wb-chat" data-pane="chat" aria-labelledby="ch-h">
        <h3 class="wb-pane-title" id="ch-h">Aero</h3>
        <div class="ch-log" id="ch-log" aria-live="polite">
          <p class="ch-turn ch-aero">
            <b>Aero</b> The retained Level 4 run passed its required numerical gates, and the frozen
            Levels 2 / 3 / 4 family passed the predeclared 2% pressure-drop mesh-independence gate.
            Validation and intended-use fidelity remain not established, so this is not yet design-ready.
          </p>
        </div>
        <div class="ch-prompts">
          <button type="button" class="ch-prompt" data-q="mesh">Show me the mesh</button>
          <button type="button" class="ch-prompt" data-q="validation">Why isn't this validated?</button>
          <button type="button" class="ch-prompt" data-q="independence">How was mesh independence established?</button>
          <button type="button" class="ch-prompt" data-q="continuity">What governs mass conservation?</button>
          <button type="button" class="ch-prompt" data-q="first-order">Show the pre-solve estimate</button>
          <button type="button" class="ch-prompt" data-q="next">What would you do next?</button>
        </div>
        <form class="local-run" id="local-run" hidden>
          <p><b>Local bounded execution</b> The token remains in this page's memory and is never written to storage.</p>
          <label>Local Aero token <input id="local-token" type="password" autocomplete="off" /></label>
          <label>Engineering request <textarea id="local-message" maxlength="500" rows="5">Generate an axisymmetric nozzle with inlet radius 20 mm, throat radius 8 mm, exit radius 24 mm, converging length 45 mm, diverging length 110 mm, mesh size 5 mm, and mass flow 0.010 kg/s</textarea></label>
          <button type="submit">Prepare proposal</button>
          <button type="button" id="mesh-study-preset">Prepare 5 / 4 / 3 mm mesh study</button>
          <button type="button" id="wall-study-preset">Prepare wall-resolved mesh study</button>
          <div id="local-proposal" class="local-proposal" hidden></div>
          <ol id="run-events" class="run-events" aria-live="polite"></ol>
        </form>
        <p class="ch-note">
          Explanations stay tied to structured case and evidence state. A local request can only become
          an allowlisted mass-flow run, fixed axisymmetric-nozzle schema, or reviewed mesh study; it cannot create
          commands, paths, arbitrary CAD code, solver dictionaries, or container settings.
        </p>
      </section>
    </div>

    <!-- =========================== EVIDENCE RAIL ========================== -->
    <section class="wb-pane wb-evidence" data-pane="evidence" aria-labelledby="ev-h">
      <h3 class="wb-pane-title" id="ev-h">Engineering evidence</h3>

      <div class="ev-cols">
        <div class="ev-col">
          <h4>Execution</h4>
          <div class="ev-row"><span>Status</span><b id="ev-execution-status" class={statusClass(evidence.execution.status)}>{evidence.execution.status}</b></div>
          <div class="ev-row"><span>Solver runtime</span><b id="ev-solver-runtime" class="unknown">{fmtRuntime(solverRuntime)}</b></div>
          <div class="ev-row"><span>Request to result</span><b id="ev-total-runtime" class={totalRuntime ? '' : 'unknown'}>{fmtRuntime(totalRuntime)}</b></div>
        </div>

        <div class="ev-col">
          <h4>Numerical evidence</h4>
          {evidence.numerical.gates.map((gate) => (
            <button type="button" class="ev-row ev-clickable" data-gate={gate.id} aria-expanded="false">
              <span>{gate.label}</span>
              <b class={statusClass(gate.status)}>{STATUS_LABEL[gate.status]}</b>
            </button>
          ))}
          <div class="ev-row ev-agg">
            <span>Numerical acceptability</span>
            <b id="ev-numerical-status" class={statusClass(evidence.numerical.status)}>{STATUS_LABEL[evidence.numerical.status]}</b>
          </div>
        </div>

        <div class="ev-col">
          <h4>Design readiness</h4>
          {evidence.readiness.gates.map((gate) => (
            <button type="button" class="ev-row ev-clickable" data-gate={gate.id} aria-expanded="false">
              <span>{gate.label}</span>
              <b class={statusClass(gate.status)}>{STATUS_LABEL[gate.status]}</b>
            </button>
          ))}
          <div class="ev-row ev-agg">
            <span>Overall design readiness</span>
            <b id="ev-readiness-status" class={statusClass(evidence.readiness.status)}>{STATUS_LABEL[evidence.readiness.status]}</b>
          </div>
        </div>
      </div>

      <div class="ev-detail" id="ev-detail" hidden>
        <button type="button" class="ev-close" aria-label="Close detail">×</button>
        <div id="ev-detail-body"></div>
      </div>
    </section>
  </div>

  </details>
  <script
    id="ev-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify({
      numerical: evidence.numerical.gates,
      readiness: evidence.readiness.gates,
      provLabels: PROVENANCE_LABEL,
      statusLabels: STATUS_LABEL,
    })}
  />

  <script>
    // ---------------------------------------------------------------
    // Workbench client. Small, dependency-free, and strictly bounded:
    // chat replies may only request actions on a fixed allowlist, and
    // every action is validated before it touches viewport state.
    // ---------------------------------------------------------------
    const root = document.getElementById('workbench');
    if (root) {
      const currentMode = new URLSearchParams(window.location.search).get('mode') === 'current';
      if (currentMode) {
        const publicWorkspace = document.querySelector('[data-guided-demo]');
        publicWorkspace?.classList.add('is-current-mode');
        const brandMode = publicWorkspace?.querySelector('.guided-brand small');
        if (brandMode) brandMode.textContent = 'Public current workspace';
        const sceneLabel = publicWorkspace?.querySelector('.guided-scene-head > div > span');
        if (sceneLabel) sceneLabel.textContent = 'Current browser workspace';
        const sceneTitle = publicWorkspace?.querySelector('#guided-demo-title');
        if (sceneTitle) sceneTitle.textContent = 'Define a case, then inspect every stage.';
        const sceneSummary = publicWorkspace?.querySelector('.guided-scene-head > p');
        if (sceneSummary) sceneSummary.textContent = 'Choose a recorded case or start a requirement record. No VM or solver controls are exposed here.';
        const playerMode = publicWorkspace?.querySelector('.demo-player-head span:last-child');
        if (playerMode) playerMode.textContent = 'Current Aero workspace · Recorded evidence';
        const playerTitle = publicWorkspace?.querySelector('[data-tour-title]');
        if (playerTitle) playerTitle.textContent = 'Inspect the current engineering record.';
        const playerSummary = publicWorkspace?.querySelector('[data-tour-summary]');
        if (playerSummary) playerSummary.textContent = 'Choose a case above, then open a stage or ask Aero about the evidence.';
        const playLabel = publicWorkspace?.querySelector('[data-tour-play]');
        if (playLabel) playLabel.textContent = 'Open requirements';
        const questions = publicWorkspace?.querySelector('[data-tour-questions]');
        if (questions) questions.open = true;
        document.title = 'Aero Current / Public engineering tool suite';
        const modeLabel = document.getElementById('wb-mode-label');
        const modeTitle = document.getElementById('wb-title');
        const modeDescription = document.getElementById('wb-mode-description');
        if (modeLabel) modeLabel.textContent = 'Aero Current / Public front end / No VM access';
        if (modeTitle) modeTitle.textContent = 'Use the Aero engineering workspace without opening the execution VM.';
        if (modeDescription) modeDescription.textContent = 'Define and inspect requirements, first-principles math, CAD, mesh, recorded solver results, and evidence in the browser. The public front end cannot start the private VM or high-fidelity solver routes.';
      }
      const cfg = JSON.parse(root.dataset.state || '{}');
      const evData = JSON.parse(document.getElementById('ev-data')?.textContent || '{}');

      const ACTIONS = new Set([
        'SHOW_NOTEBOOK_SECTION', 'SHOW_ANALYSIS_STEP', 'SET_VIEWPORT_MODE', 'SET_RESULT_FIELD', 'TOGGLE_MESH',
        'RESET_CAMERA', 'SELECT_RUN', 'COMPARE_RUNS', 'EXPLAIN_GATE',
        'PROPOSE_PARAMETER_CHANGE', 'PROPOSE_GEOMETRY', 'REQUEST_RUN', 'REQUEST_MESH_STUDY',
        'REQUEST_WALL_RESOLVED_MESH_STUDY',
      ]);
      const MODES = new Set(['geometry', 'mesh', 'result']);
      const FIELDS = new Set(['pressure', 'velocity', 'mach', 'temperature']);
      const ANALYSIS_STEPS = new Set(['scope', 'area', 'density', 'velocity', 'mach', 'dynamic-pressure', 'limits']);

      /** Reject anything not on the allowlist or malformed. No eval, ever. */
      function validate(raw) {
        if (!raw || typeof raw !== 'object') return null;
        if (typeof raw.action !== 'string' || !ACTIONS.has(raw.action)) return null;
        if (raw.action === 'SET_VIEWPORT_MODE' && !MODES.has(raw.mode)) return null;
        if (raw.action === 'SET_RESULT_FIELD' && !FIELDS.has(raw.field)) return null;
        if (raw.action === 'SHOW_NOTEBOOK_SECTION' && typeof raw.section !== 'string') return null;
        if (raw.action === 'SHOW_ANALYSIS_STEP' && !ANALYSIS_STEPS.has(raw.analysisStep)) return null;
        if (raw.action === 'EXPLAIN_GATE' && typeof raw.gateId !== 'string') return null;
        return raw;
      }

      const state = {
        mode: 'geometry', field: null, meshVisible: false,
        camera: { zoom: 1, panX: 0, panY: 0 }, runId: cfg.runId,
      };

      const img = document.getElementById('vp-image');
      const stage = document.getElementById('vp-stage');
      const hint = document.getElementById('vp-hint');
      const scientific = document.getElementById('vp-scientific');
      const legend = document.getElementById('vp-legend');
      let scientificViewer = null;
      let activeScientificMode = null;
      let modeRequestId = 0;
      let liveCadArtifact = cfg.publicCadArtifact || null;
      let livePressureField = cfg.publicPressureField || null;

      function artifactRequest(href, token) {
        const isPublicDemo = typeof href === 'string' && href.startsWith('/demos/aero/');
        return {
          url: isPublicDemo ? href : `${cfg.localApi}${href}`,
          options: isPublicDemo ? {} : { headers: { 'X-Aero-Token': token } },
        };
      }

      function drawChart(kind, telemetry) {
        const body = document.querySelector(`[data-chart="${kind}"] .chart-body`);
        if (!body) return;
        let named = {};
        let transform = (value) => value;
        if (kind === 'residuals') {
          named = telemetry?.residuals || {};
          transform = (value) => Math.log10(Math.max(Number(value), 1e-16));
        }
        if (kind === 'mass') named = { imbalance: (telemetry?.massConservation || []).map((p) => ({ sample: p.sample, value: p.fraction })) };
        if (kind === 'energy') named = { imbalance: (telemetry?.energyConservation || []).map((p) => ({ sample: p.sample, value: p.fraction })) };
        if (kind === 'monitor') named = telemetry?.monitors || {};
        const series = Object.entries(named)
          .map(([name, points]) => ({ name, points: (points || []).filter((p) => Number.isFinite(Number(p.value))) }))
          .filter((entry) => entry.points.length);
        body.replaceChildren();
        if (!series.length) {
          const missing = document.createElement('p');
          missing.className = 'chart-missing';
          missing.textContent = 'NOT EVALUATED — no real series was reported';
          body.appendChild(missing);
          return;
        }
        const all = series.flatMap((entry) => entry.points.map((point) => transform(Number(point.value))));
        const low = Math.min(...all), high = Math.max(...all);
        const span = high - low || 1;
        const maxSamples = Math.max(...series.map((entry) => entry.points.length));
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 300 92');
        svg.setAttribute('role', 'img');
        svg.setAttribute('aria-label', `${kind} telemetry, ${maxSamples} real samples`);
        const colors = ['#d7653f', '#6d9b91', '#d8cda9', '#8795a1'];
        series.forEach((entry, index) => {
          const polyline = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
          const points = entry.points.map((point, pointIndex) => {
            const x = entry.points.length === 1 ? 150 : 5 + (pointIndex / (entry.points.length - 1)) * 290;
            const y = 87 - ((transform(Number(point.value)) - low) / span) * 82;
            return `${x},${y}`;
          }).join(' ');
          polyline.setAttribute('points', points);
          polyline.setAttribute('fill', 'none');
          polyline.setAttribute('stroke', colors[index % colors.length]);
          polyline.setAttribute('stroke-width', '1.5');
          svg.appendChild(polyline);
        });
        body.appendChild(svg);
        const meta = document.createElement('small');
        meta.textContent = `${maxSamples} real sample${maxSamples === 1 ? '' : 's'}${kind === 'residuals' ? ' / log₁₀ scale' : ''}`;
        body.appendChild(meta);
      }

      function drawTelemetry(telemetry) {
        ['residuals', 'mass', 'energy', 'monitor'].forEach((kind) => drawChart(kind, telemetry));
      }

      function commitViewportMode(mode, hintText) {
        const isMesh = mode === 'mesh';
        const isResult = mode === 'result';
        state.mode = mode;
        state.field = isResult ? 'pressure' : null;
        state.meshVisible = isMesh;
        activeScientificMode = mode;
        if (scientific) {
          scientific.dataset.viewMode = mode;
          scientific.setAttribute('aria-label', isResult
            ? 'Interactive three-dimensional OpenFOAM pressure result. Drag to orbit, right drag to pan, and scroll to zoom.'
            : isMesh
              ? 'Interactive three-dimensional nozzle surface triangulation. Drag to orbit, right drag to pan, and scroll to zoom.'
              : 'Interactive three-dimensional nozzle geometry. Drag to orbit, right drag to pan, and scroll to zoom.');
        }
        if (stage) stage.dataset.viewMode = mode;
        if (legend) legend.hidden = !isResult;
        document.querySelectorAll('.vp-mode').forEach((button) => {
          const active = button.dataset.mode === mode;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        });
        document.querySelectorAll('.vp-field').forEach((button) =>
          button.classList.toggle('is-active', isResult && button.dataset.field === 'pressure'));
        const meshControl = document.querySelector('[data-vp="mesh"]');
        if (meshControl) meshControl.textContent = isMesh ? 'Geometry view' : 'Mesh view';
        if (hint && hintText) hint.textContent = hintText;
      }

      async function showPressureField(field, token, requestId = ++modeRequestId) {
        if (!field?.href || !scientific) return;
        const request = artifactRequest(field.href, token);
        const response = await fetch(request.url, request.options);
        if (!response.ok) throw new Error(`pressure surface unavailable (${response.status})`);
        const surface = await response.json();
        const { mountPressureViewer } = await import('../../../../lib/aero/pressure-viewer');
        if (requestId !== modeRequestId) return;
        scientificViewer?.dispose();
        scientific.hidden = false;
        if (img) img.hidden = true;
        scientificViewer = mountPressureViewer(scientific, surface);
        scientificViewer.setMeshVisible(false);
        const max = document.getElementById('vp-legend-max');
        const min = document.getElementById('vp-legend-min');
        if (max) max.textContent = Number(surface.range[1]).toFixed(2);
        if (min) min.textContent = Number(surface.range[0]).toFixed(2);
        const unavailable = document.querySelector('.vp-none');
        if (unavailable) unavailable.hidden = true;
        const fieldArea = document.querySelector('.vp-fields');
        if (fieldArea && !fieldArea.querySelector('[data-field="pressure"]')) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'vp-field is-active';
          button.dataset.field = 'pressure';
          button.textContent = 'Pressure / Pa';
          button.addEventListener('click', () => setMode('result'));
          fieldArea.appendChild(button);
        }
        commitViewportMode('result', 'Pressure / Pa — interactive solver-output surface; drag to orbit, right drag to pan, scroll to zoom');
      }

      async function showCadMode(artifact, token, mode, requestId = ++modeRequestId) {
        if (!artifact?.href || !scientific) return;
        const request = artifactRequest(artifact.href, token);
        const response = await fetch(request.url, request.options);
        if (!response.ok) throw new Error(`generated CAD unavailable (${response.status})`);
        const payload = await response.arrayBuffer();
        const { mountCadViewer } = await import('../../../../lib/aero/cad-viewer');
        if (requestId !== modeRequestId) return;
        scientificViewer?.dispose();
        scientific.hidden = false;
        if (img) img.hidden = true;
        scientificViewer = mountCadViewer(scientific, payload);
        scientificViewer.setMeshVisible(mode === 'mesh');
        commitViewportMode(mode, mode === 'mesh'
          ? 'Surface triangulation of the same nozzle STL — solver volume-mesh checks are recorded in evidence'
          : 'Parametric nozzle cutaway STL — drag to orbit, right drag to pan, scroll to zoom');
      }

      drawTelemetry(cfg.recordedTelemetry || {});

      function applyCamera() {
        if (!img) return;
        const c = state.camera;
        img.style.transform = `translate(${c.panX}px, ${c.panY}px) scale(${c.zoom})`;
      }

      async function setMode(mode) {
        if (!MODES.has(mode)) return;
        const requestId = ++modeRequestId;
        try {
          if ((mode === 'geometry' || mode === 'mesh') && liveCadArtifact) {
            await showCadMode(liveCadArtifact, localToken?.value || '', mode, requestId);
            return;
          }
          if (mode === 'result' && livePressureField) {
            await showPressureField(livePressureField, localToken?.value || '', requestId);
            return;
          }
        } catch (error) {
          if (requestId === modeRequestId) appendAero(error.message);
          return;
        }
        const src = cfg.artifacts?.[mode];
        if (!src) {
          appendAero(`${mode} is unavailable for this case. The current view is unchanged.`);
          return;
        }
        const useScientific = mode === activeScientificMode && scientificViewer;
        if (scientific) scientific.hidden = !useScientific;
        if (legend) legend.hidden = mode !== 'result';
        if (img) img.hidden = Boolean(useScientific);
        if (img && src && !useScientific) {
          img.src = src;
          img.alt = `Wall-resolved axisymmetric nozzle ${mode}`;
        }
        commitViewportMode(mode, `${mode[0].toUpperCase()}${mode.slice(1)} — drag to pan, scroll to zoom`);
      }

      function resetCamera() {
        if (scientificViewer && state.mode === activeScientificMode) scientificViewer.resetCamera();
        state.camera = { zoom: 1, panX: 0, panY: 0 };
        applyCamera();
      }

      function showSection(id) {
        const el = document.getElementById(`nb-${id}`);
        if (!el) return;
        showTab('notebook');
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        el.classList.add('nb-flash');
        setTimeout(() => el.classList.remove('nb-flash'), 1600);
        el.focus({ preventScroll: true });
      }

      function calculateAnalysis(massFlowKgS) {
        const inputs = cfg.analysis?.inputs || {};
        const areaM2 = Math.PI * Number(inputs.inletRadiusM) ** 2;
        const densityKgM3 = Number(inputs.referencePressurePa)
          / (Number(inputs.gasConstantJkgK) * Number(inputs.referenceTemperatureK));
        const velocityMS = massFlowKgS / (densityKgM3 * areaM2);
        const speedOfSoundMS = Math.sqrt(
          Number(inputs.heatCapacityRatio) * Number(inputs.gasConstantJkgK) * Number(inputs.referenceTemperatureK),
        );
        return {
          areaM2, densityKgM3, velocityMS, speedOfSoundMS,
          mach: velocityMS / speedOfSoundMS,
          dynamicPressurePa: 0.5 * densityKgM3 * velocityMS ** 2,
        };
      }

      function updateAnalysis(massFlowKgS, label = 'CASE INPUT') {
        if (!Number.isFinite(massFlowKgS) || massFlowKgS <= 0) return;
        const values = calculateAnalysis(massFlowKgS);
        const formats = {
          areaM2: (value) => value.toExponential(4),
          densityKgM3: (value) => value.toFixed(4),
          velocityMS: (value) => value.toFixed(3),
          speedOfSoundMS: (value) => value.toFixed(2),
          mach: (value) => value.toFixed(5),
          dynamicPressurePa: (value) => value.toFixed(2),
        };
        const input = document.querySelector('[data-analysis-input="massFlowKgS"]');
        if (input) input.textContent = massFlowKgS.toFixed(3);
        Object.entries(values).forEach(([key, value]) => {
          const target = document.querySelector(`[data-analysis-value="${key}"]`);
          if (target) target.textContent = formats[key]?.(value) || String(value);
        });
        const status = document.querySelector('.an-status');
        if (status) status.textContent = `${label} / ANALYTICAL / PRE-RUN`;
      }

      function showAnalysisStep(id) {
        if (!ANALYSIS_STEPS.has(id)) return;
        showTab('analysis');
        document.querySelectorAll('[data-analysis-target]').forEach((button) =>
          {
            const active = button.dataset.analysisTarget === id;
            button.classList.toggle('is-active', active);
            if (active) button.setAttribute('aria-current', 'step');
            else button.removeAttribute('aria-current');
          });
        const step = document.getElementById(`analysis-${id}`);
        if (!step) return;
        step.scrollIntoView({ behavior: 'smooth', block: 'center' });
        step.classList.add('an-flash');
        setTimeout(() => step.classList.remove('an-flash'), 1600);
        step.focus({ preventScroll: true });
      }

      document.querySelectorAll('[data-analysis-target]').forEach((button) =>
        button.addEventListener('click', () => showAnalysisStep(button.dataset.analysisTarget)));

      document.querySelectorAll('[data-analysis-view]').forEach((button) =>
        button.addEventListener('click', () => {
          const view = button.dataset.analysisView;
          document.querySelectorAll('[data-analysis-view]').forEach((candidate) =>
            {
              const active = candidate === button;
              candidate.classList.toggle('is-active', active);
              candidate.setAttribute('aria-pressed', String(active));
            });
          document.querySelectorAll('[data-analysis-panel]').forEach((panel) => {
            panel.hidden = panel.dataset.analysisPanel !== view;
          });
        }));

      function apply(action) {
        const a = validate(action);
        if (!a) return;
        switch (a.action) {
          case 'SET_VIEWPORT_MODE': setMode(a.mode); showTab('viewport'); break;
          case 'RESET_CAMERA': resetCamera(); break;
          case 'SHOW_NOTEBOOK_SECTION': showSection(a.section); break;
          case 'SHOW_ANALYSIS_STEP': showAnalysisStep(a.analysisStep); break;
          case 'EXPLAIN_GATE': openGate(a.gateId); break;
          default: break; // recognised but not yet wired
        }
      }

      // ---- viewport interaction
      document.querySelectorAll('.vp-mode').forEach((btn) =>
        btn.addEventListener('click', () => setMode(btn.dataset.mode)));
      document.querySelectorAll('[data-field="pressure"]').forEach((btn) =>
        btn.addEventListener('click', () => setMode('result')));
      document.querySelectorAll('[data-vp]').forEach((btn) =>
        btn.addEventListener('click', () => {
          const k = btn.dataset.vp;
          if (k === 'zoom-in' && scientificViewer && state.mode === activeScientificMode) return scientificViewer.zoom(1.25);
          if (k === 'zoom-out' && scientificViewer && state.mode === activeScientificMode) return scientificViewer.zoom(0.8);
          if (k === 'zoom-in') state.camera.zoom = Math.min(6, state.camera.zoom * 1.25);
          if (k === 'zoom-out') state.camera.zoom = Math.max(0.4, state.camera.zoom / 1.25);
          if (k === 'reset') {
            return resetCamera();
          }
          if (k === 'mesh') {
            return setMode(state.mode === 'mesh' ? 'geometry' : 'mesh');
          }
          applyCamera();
        }));

      let dragging = false, lastX = 0, lastY = 0;
      stage?.addEventListener('pointerdown', (e) => {
        if (scientificViewer && state.mode === activeScientificMode) return;
        dragging = true; lastX = e.clientX; lastY = e.clientY;
        stage.setPointerCapture(e.pointerId);
      });
      stage?.addEventListener('pointermove', (e) => {
        if (scientificViewer && state.mode === activeScientificMode) return;
        if (!dragging) return;
        state.camera.panX += e.clientX - lastX;
        state.camera.panY += e.clientY - lastY;
        lastX = e.clientX; lastY = e.clientY;
        applyCamera();
      });
      stage?.addEventListener('pointerup', () => { dragging = false; });
      stage?.addEventListener('wheel', (e) => {
        if (scientificViewer && state.mode === activeScientificMode) return;
        e.preventDefault();
        const f = e.deltaY < 0 ? 1.12 : 1 / 1.12;
        state.camera.zoom = Math.min(6, Math.max(0.4, state.camera.zoom * f));
        applyCamera();
      }, { passive: false });
      stage?.addEventListener('keydown', (e) => {
        if (scientificViewer && state.mode === activeScientificMode) {
          if (e.key === '+' || e.key === '=') scientificViewer.zoom(1.2);
          else if (e.key === '-') scientificViewer.zoom(1 / 1.2);
          else if (e.key === '0') resetCamera();
          else return;
          e.preventDefault();
          return;
        }
        const step = 24;
        if (e.key === 'ArrowLeft') state.camera.panX += step;
        else if (e.key === 'ArrowRight') state.camera.panX -= step;
        else if (e.key === 'ArrowUp') state.camera.panY += step;
        else if (e.key === 'ArrowDown') state.camera.panY -= step;
        else if (e.key === '+' || e.key === '=') state.camera.zoom = Math.min(6, state.camera.zoom * 1.2);
        else if (e.key === '-') state.camera.zoom = Math.max(0.4, state.camera.zoom / 1.2);
        else if (e.key === '0') return resetCamera();
        else return;
        e.preventDefault();
        applyCamera();
      });

      // ---- evidence detail
      let allGates = [...(evData.numerical || []), ...(evData.readiness || [])];
      const detail = document.getElementById('ev-detail');
      const detailBody = document.getElementById('ev-detail-body');

      function openGate(id) {
        const gate = allGates.find((g) => g.id === id);
        if (!gate || !detail || !detailBody) return;
        const rows = [];
        rows.push(`<h4>${gate.label} — <span class="${
          gate.status === 'PASS' ? 'ok' : gate.status === 'FAIL' ? 'bad' : 'unknown'
        }">${(evData.statusLabels || {})[gate.status] || gate.status}</span></h4>`);
        if (gate.value !== null && gate.value !== undefined)
          rows.push(`<div class="ev-kv"><span>Measured value</span><b>${gate.value}${gate.units ? ' ' + gate.units : ''}</b></div>`);
        if (gate.limit !== null && gate.limit !== undefined)
          rows.push(`<div class="ev-kv"><span>Acceptance limit</span><b>${gate.limit}${gate.units ? ' ' + gate.units : ''}</b></div>`);
        rows.push(`<div class="ev-kv"><span>Required</span><b>${gate.required ? 'yes' : 'no'}</b></div>`);
        rows.push(`<div class="ev-kv"><span>Provenance</span><b>${(evData.provLabels || {})[gate.source] || gate.source}</b></div>`);
        rows.push(`<p class="ev-reason">${gate.reason}</p>`);
        detailBody.innerHTML = rows.join('');
        detail.hidden = false;
        showTab('evidence');
        detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      document.querySelectorAll('[data-gate]').forEach((btn) =>
        btn.addEventListener('click', () => openGate(btn.dataset.gate)));
      detail?.querySelector('.ev-close')?.addEventListener('click', () => { detail.hidden = true; });

      // ---- chat (curated; each reply may request allowlisted actions only)
      const REPLIES = {
        mesh: {
          text: 'Switching to the surface triangulation of the same nozzle STL. This visual overlay is distinct from the retained Level 4 OpenFOAM volume mesh, whose 12,600-cell count is recorded in evidence.',
          actions: [{ action: 'SET_VIEWPORT_MODE', mode: 'mesh' }],
        },
        validation: {
          text: 'Because no validation reference is attached to this case. There is no experiment, analytical solution, published benchmark or trusted-solver comparison recorded against it, so there is nothing to be right or wrong against. Converging is not evidence of correctness.',
          actions: [{ action: 'EXPLAIN_GATE', gateId: 'validation_reference' }],
        },
        independence: {
          text: 'All three retained levels were numerically acceptable. Pressure drop changed 1.5153% from Level 2 to 3 and 0.0191% from Level 3 to 4, so the worst adjacent change remained below the predeclared 2% threshold.',
          actions: [{ action: 'EXPLAIN_GATE', gateId: 'mesh_independence' }],
        },
        continuity: {
          text: 'Steady mass continuity, ṁ = ρAV, sets the independent inlet velocity scale. Opening the pre-solve derivation so the inputs, substitution, and result remain separate from CFD output.',
          actions: [{ action: 'SHOW_ANALYSIS_STEP', analysisStep: 'velocity' }],
        },
        'first-order': {
          text: 'The pre-solve screen establishes area, ideal-gas reference density, mean inlet velocity, speed of sound, Mach number, and a dynamic-pressure scale from case inputs. It does not claim an analytical nozzle pressure drop.',
          actions: [{ action: 'SHOW_ANALYSIS_STEP', analysisStep: 'scope' }],
        },
        next: {
          text: 'Next, attach an external validation reference, establish wall-resolution suitability, and substantiate the model-fidelity claim for the intended engineering use. Mesh independence alone does not establish design readiness.',
          actions: [{ action: 'SHOW_NOTEBOOK_SECTION', section: 'interpretation' }],
        },
      };

      const log = document.getElementById('ch-log');

      function appendUser(text) {
        if (!log) return;
        const turn = document.createElement('p');
        turn.className = 'ch-turn ch-user';
        const who = document.createElement('b');
        who.textContent = 'You';
        turn.append(who, document.createTextNode(` ${text}`));
        log.appendChild(turn);
        log.scrollTop = log.scrollHeight;
      }

      document.querySelectorAll('.ch-prompt').forEach((btn) =>
        btn.addEventListener('click', () => {
          const key = btn.dataset.q;
          const reply = REPLIES[key];
          if (!reply || !log) return;
          const q = document.createElement('p');
          q.className = 'ch-turn ch-user';
          q.innerHTML = `<b>You</b> ${btn.textContent}`;
          log.appendChild(q);
          const a = document.createElement('p');
          a.className = 'ch-turn ch-aero';
          a.innerHTML = `<b>Aero</b> ${reply.text}`;
          log.appendChild(a);
          log.scrollTop = log.scrollHeight;
          (reply.actions || []).forEach(apply);
        }));

      const analysisQuestion = document.getElementById('analysis-question');
      const analysisQuery = document.getElementById('analysis-query');
      analysisQuestion?.addEventListener('submit', (event) => {
        event.preventDefault();
        const question = String(analysisQuery?.value || '').trim();
        if (!question) return;
        const normalized = question.toLowerCase();
        let step = 'scope';
        let answer = 'This derivation is limited to the declared pre-solve screening chain. I opened its scope and authority boundary.';
        if (/area|radius|diameter/.test(normalized)) {
          step = 'area'; answer = 'The inlet reference area comes directly from the deterministic 20 mm inlet radius: Aᵢ = πrᵢ².';
        } else if (/density|ideal gas|rho|pressure.*temperature/.test(normalized)) {
          step = 'density'; answer = 'Reference density uses the ideal-gas relation at the declared pressure and temperature. It is not the CFD density field.';
        } else if (/continuity|mass flow|velocity/.test(normalized)) {
          step = 'velocity'; answer = 'Continuity converts commanded mass flow, reference density, and inlet area into the independent mean-velocity scale.';
        } else if (/mach|speed of sound|compressib/.test(normalized)) {
          step = 'mach'; answer = 'The Mach screen divides the independently calculated inlet velocity by the ideal-gas reference speed of sound.';
        } else if (/dynamic|pressure scale|quadratic/.test(normalized)) {
          step = 'dynamic-pressure'; answer = 'Dynamic pressure provides an order-of-magnitude scale and shows the quadratic mass-flow trend; it is not the nozzle pressure drop.';
        } else if (/pressure drop|loss|not established|limit/.test(normalized)) {
          step = 'limits'; answer = 'An independent nozzle loss relation is not justified by the available inputs, so analytical pressure drop remains NOT YET ESTABLISHED.';
        }
        appendUser(question);
        appendAero(answer);
        showAnalysisStep(step);
        if (analysisQuery) analysisQuery.value = '';
      });

      // ---- authenticated loopback execution
      const localForm = document.getElementById('local-run');
      const localToken = document.getElementById('local-token');
      const localMessage = document.getElementById('local-message');
      const meshStudyPreset = document.getElementById('mesh-study-preset');
      const wallStudyPreset = document.getElementById('wall-study-preset');
      const proposalBox = document.getElementById('local-proposal');
      const eventsList = document.getElementById('run-events');
      const sessionBytes = crypto.getRandomValues(new Uint8Array(8));
      const sessionId = `sess-${Array.from(sessionBytes, (byte) => byte.toString(16).padStart(2, '0')).join('')}`;

      function statusClassName(status) {
        return status === 'PASS' || status === 'READY' || status === 'COMPLETE'
          ? 'ok' : status === 'FAIL' || status === 'NOT_READY' || status === 'FAILED' ? 'bad' : 'unknown';
      }

      function setStatusText(element, status) {
        if (!element) return;
        element.textContent = String(status || 'NOT ESTABLISHED').replaceAll('_', ' ');
        element.classList.remove('ok', 'bad', 'unknown');
        element.classList.add(statusClassName(status));
      }

      async function localRequest(path, options = {}) {
        const token = localToken?.value || '';
        const response = await fetch(`${cfg.localApi}${path}`, {
          ...options,
          headers: {
            'Content-Type': 'application/json',
            'X-Aero-Token': token,
            ...(options.headers || {}),
          },
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.reason || body.error || `request failed (${response.status})`);
        return body;
      }

      function appendAero(text) {
        if (!log) return;
        const turn = document.createElement('p');
        turn.className = 'ch-turn ch-aero';
        const who = document.createElement('b');
        who.textContent = 'Aero';
        turn.append(who, document.createTextNode(` ${text}`));
        log.appendChild(turn);
        log.scrollTop = log.scrollHeight;
      }

      function updateEvidence(result) {
        if (!result) return;
        setStatusText(document.getElementById('ev-execution-status'), result.execution?.status);
        setStatusText(document.getElementById('ev-numerical-status'), result.numerical?.status);
        setStatusText(document.getElementById('ev-readiness-status'), result.readiness?.status);
        const solverTime = document.getElementById('ev-solver-runtime');
        const totalTime = document.getElementById('ev-total-runtime');
        if (solverTime) solverTime.textContent = result.execution?.runtime_display?.solver || 'NOT RECORDED';
        if (totalTime) totalTime.textContent = result.execution?.runtime_display?.total || 'NOT RECORDED';
        evData.numerical = result.numerical?.gates || [];
        evData.readiness = result.readiness?.gates || [];
        allGates = [...evData.numerical, ...evData.readiness];
        allGates.forEach((gate) => {
          const button = document.querySelector(`[data-gate="${gate.id}"]`);
          const status = button?.querySelector('b');
          setStatusText(status, gate.status);
        });
      }

      function renderEvents(run) {
        if (!eventsList) return;
        eventsList.replaceChildren();
        (run.events || []).forEach((event) => {
          const item = document.createElement('li');
          const stateLabel = document.createElement('b');
          stateLabel.textContent = event.status.replaceAll('_', ' ');
          item.append(stateLabel, document.createTextNode(` — ${event.reason}`));
          eventsList.appendChild(item);
        });
        const status = document.getElementById('run-status');
        setStatusText(status, run.status);
        const mode = document.getElementById('run-mode');
        if (mode) mode.textContent = 'LIVE LOCAL RUN';
      }

      async function pollRun(jobId) {
        while (true) {
          const body = await localRequest(`/tools/aero/workbench/run/${jobId}`);
          const run = body.run;
          renderEvents(run);
          drawTelemetry(run.telemetry || {});
          if (['COMPLETE', 'FAILED', 'TIMED_OUT', 'CANCELLED'].includes(run.status)) {
            if (run.result) {
              updateEvidence(run.result);
              const pressure = (run.result.resultFields || []).find((field) => field.field === 'p' && field.href);
              liveCadArtifact = (run.result.artifacts || []).find(
                (artifact) => artifact.type === 'geometry' && artifact.publicFormat === 'stl' && artifact.href,
              );
              livePressureField = pressure || null;
              if (pressure) {
                await setMode('result');
                showTab('viewport');
              }
              const mesh = run.result.geometryManifest?.checks;
              const geometryNote = mesh
                ? ` Generated geometry validated with ${mesh.meshNodes} nodes and ${mesh.meshVolumeElements} volume elements; use Geometry to inspect the real STL.`
                : '';
              const study = run.result.meshStudy;
              const studyNote = study?.levels?.length
                ? ` Mesh study: ${study.levels.map((level) => `${level.level}: ${level.cellCount} cells, ${level.metricValue} Pa`).join('; ')}.`
                : '';
              appendAero(`Evidence finalized. Numerical acceptability: ${run.result.numerical.status}. Design readiness: ${run.result.readiness.status}.${geometryNote}${studyNote}`);
            } else {
              appendAero(`Run ended ${run.status}. ${run.failure || 'No EngineeringResult was finalized.'}`);
            }
            return;
          }
          await new Promise((resolve) => setTimeout(resolve, 1000));
        }
      }

      function showProposal(proposal) {
        if (!proposalBox || !proposal) return;
        const configuration = proposal.immutable_configuration || {};
        const proposedMassFlow = [
          configuration.mass_flow_kg_s,
          configuration.massFlowKgS,
          configuration.mass_flow,
          configuration.inputs?.mass_flow_kg_s,
          configuration.parameters?.mass_flow_kg_s,
          configuration.case?.mass_flow_kg_s,
        ].map(Number).find((value) => Number.isFinite(value) && value > 0);
        if (proposedMassFlow) updateAnalysis(proposedMassFlow, 'PROPOSED INPUT');
        proposalBox.replaceChildren();
        const heading = document.createElement('h4');
        heading.textContent = 'Immutable proposed configuration';
        const pre = document.createElement('pre');
        pre.textContent = JSON.stringify(configuration, null, 2);
        const criteriaHeading = document.createElement('h4');
        criteriaHeading.textContent = 'Criteria fixed before solving';
        const criteria = document.createElement('ul');
        proposal.predeclared_criteria.forEach((gate) => {
          const item = document.createElement('li');
          item.textContent = `${gate.id}: required${gate.maximum !== undefined ? ` / maximum ${gate.maximum}` : ''}`;
          criteria.appendChild(item);
        });
        const approve = document.createElement('button');
        approve.type = 'button';
        approve.textContent = 'Approve this exact configuration and run';
        approve.addEventListener('click', async () => {
          approve.disabled = true;
          try {
            const body = await localRequest('/tools/aero/workbench/approve', {
              method: 'POST',
              body: JSON.stringify({
                proposal_id: proposal.proposal_id,
                fingerprint: proposal.fingerprint,
                session_id: sessionId,
                approved: true,
              }),
            });
            appendAero('Approval matched the frozen proposal. The isolated worker has been queued.');
            await pollRun(body.run.jobId);
          } catch (error) {
            appendAero(error instanceof Error ? error.message : String(error));
            approve.disabled = false;
          }
        });
        proposalBox.append(heading, pre, criteriaHeading, criteria, approve);
        proposalBox.hidden = false;
      }

      if (localForm && !currentMode && ['127.0.0.1', 'localhost', '::1'].includes(window.location.hostname)) {
        localForm.hidden = false;
        meshStudyPreset?.addEventListener('click', () => {
          if (localMessage) localMessage.value = 'Run the approved three-level mesh independence study';
          localMessage?.focus();
        });
        wallStudyPreset?.addEventListener('click', () => {
          if (localMessage) localMessage.value = 'Run the approved wall-resolved mesh study';
          localMessage?.focus();
        });
        localForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!localToken?.value) return appendAero('Enter the configured local Aero token to use the protected worker.');
          try {
            const body = await localRequest('/tools/aero/workbench/chat', {
              method: 'POST',
              body: JSON.stringify({ message: localMessage?.value || '', session_id: sessionId }),
            });
            appendAero(body.message);
            (body.actions || []).forEach(apply);
            showProposal(body.proposal);
          } catch (error) {
            appendAero(error instanceof Error ? error.message : String(error));
          }
        });
      }

      // ---- responsive tabs
      function showTab(name) {
        if (window.matchMedia('(min-width: 981px)').matches) return;
        document.querySelectorAll('.wb-pane').forEach((p) =>
          p.classList.toggle('is-active', p.dataset.pane === name));
        document.querySelectorAll('.wb-tab').forEach((t) => {
          const on = t.dataset.tab === name;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
        });
      }
      document.querySelectorAll('.wb-tab').forEach((t) =>
        t.addEventListener('click', () => showTab(t.dataset.tab)));

      let tourViewer = null;
      let tourRequest = 0;
      document.addEventListener('aero-demo-step', async (event) => {
        const requestId = ++tourRequest;
        const { index, blocked } = event.detail;
        const model = document.querySelector('[data-tour-model]');
        const charts = document.querySelector('[data-tour-charts]');
        tourViewer?.dispose();
        tourViewer = null;
        model.replaceChildren();
        model.hidden = true;
        charts.hidden = true;
        charts.replaceChildren();
        if (blocked) return;
        if (index === 4) {
          charts.hidden = false;
          document.querySelectorAll('.telemetry [data-chart="residuals"], .telemetry [data-chart="mass"]').forEach((chart) => charts.appendChild(chart.cloneNode(true)));
          return;
        }
        if (![2, 3, 5].includes(index)) return;
        model.hidden = false;
        model.textContent = 'Loading 3D view…';
        try {
          const href = index === 5 ? cfg.publicPressureField.href : cfg.publicCadArtifact.href;
          const response = await fetch(href);
          if (!response.ok) throw new Error('The model could not be loaded. Try this step again.');
          if (index === 5) {
            const surface = await response.json();
            const { mountPressureViewer } = await import('../../../../lib/aero/pressure-viewer');
            if (requestId !== tourRequest) return;
            tourViewer = mountPressureViewer(model, surface);
            const label = document.createElement('span');
            label.className = 'tour-field-label';
            label.textContent = `Pressure: ${surface.range[0].toLocaleString()}–${surface.range[1].toLocaleString()} Pa · Recorded solver output`;
            model.appendChild(label);
          } else {
            const payload = await response.arrayBuffer();
            const { mountCadViewer } = await import('../../../../lib/aero/cad-viewer');
            if (requestId !== tourRequest) return;
            tourViewer = mountCadViewer(model, payload);
            tourViewer.setMeshVisible(index === 3);
          }
        } catch (error) {
          if (requestId === tourRequest) model.textContent = '3D view unavailable. Select this step again to retry.';
        }
      });

      setMode('geometry');
      applyCamera();
    }
  </script>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-guided-demo]');
      if (!root) return;
      const cases = JSON.parse(document.getElementById('demo-case-data')?.textContent || '[]');
      const log = root.querySelector('[data-guided-log]');
      const form = root.querySelector('[data-guided-form]');
      const input = root.querySelector('[data-guided-message]');
      const progress = root.querySelector('[data-guided-progress]');
      const progressLabel = root.querySelector('[data-guided-progress-label]');
      const continueButton = root.querySelector('[data-guided-continue]');
      const caseLabel = root.querySelector('[data-guided-case-label]');
      const fields = Object.fromEntries([...root.querySelectorAll('[data-record]')].map((node) => [node.dataset.record, node]));
      const stageNodes = [...root.querySelectorAll('[data-guided-stage]')];
      let activeCase = null;
      let current = { goal: '', geometry: '', operating: '', evidence: '' };
      let tourIndex = -1;
      let tourModified = false;
      const tourNames = ['Requirements', 'Math', 'CAD', 'Mesh', 'Solve', 'Render'];
      const tourNarratives = [
        ['Define the question', 'What do we want to learn?', 'First I capture the goal, available geometry, operating conditions, and what would count as a useful answer.'],
        ['Check the physics', 'Estimate before solving.', 'I use mass conservation to estimate inlet velocity. This gives us a simple reference to compare with the CFD result.'],
        ['Inspect the nozzle', 'Rotate the model to look inside.', 'Here is the nozzle cutaway. I check dimensions and surfaces before preparing the mesh. Drag to rotate; scroll to zoom.'],
        ['Prepare the mesh', 'The same nozzle, divided into surface triangles.', 'The lines show this CAD surface’s triangulation. The separate CFD volume mesh is checked for quality and sensitivity to refinement.'],
        ['Check the solver', 'Recorded convergence history.', 'I watch residuals and mass balance together. These charts replay a completed run; pressing Next does not launch a solver.'],
        ['Review the result', 'Pressure from the recorded OpenFOAM run.', 'The colors show the solved pressure field on the axisymmetric wedge. Numerical checks passed. Comparison with an independent reference is still needed.'],
      ];
      const renderTour = () => {
        const playing = tourIndex >= 0;
        const cooling = activeCase?.id === 'cooling-channel';
        const blocked = playing && tourIndex >= 2 && (cooling || tourModified);
        const script = playing ? [...tourNarratives[tourIndex]] : ['See how Aero turns a question into a CFD workflow.', 'Choose an example, then press Play.', 'Press Play and I’ll explain each step. You choose when to continue.'];
        if (playing && tourIndex === 0) script[1] = activeCase?.question || script[1];
        if (playing && cooling && tourIndex === 1) {
          script[1] = 'Balance the heat load against coolant flow.';
          script[2] = 'We know the heat load is 8 kW. To estimate flow, we still need an allowed temperature rise and the coolant properties.';
        }
        if (blocked) {
          script[0] = `${tourNames[tourIndex]} needs more work`;
          script[1] = cooling ? 'This screening example has no completed CFD run.' : 'Your changes need a new geometry and solver run.';
          script[2] = cooling ? 'I stop here until channel dimensions, flow conditions, and acceptance limits are supplied. There is no solved model to show for this example.' : 'I saved your proposed change in the record. The earlier nozzle results do not describe that revised design.';
        }
        root.querySelector('[data-tour-title]').textContent = script[0];
        root.querySelector('[data-tour-summary]').textContent = script[1];
        root.querySelector('[data-tour-narration]').textContent = script[2];
        root.querySelector('[data-tour-kicker]').textContent = playing ? `${tourNames[tourIndex]} · ${activeCase?.title || 'Nozzle demo'}` : 'Requirements → Math → CAD → Mesh → Solve → Render';
        root.querySelector('[data-tour-counter]').textContent = playing ? `Step ${tourIndex + 1} of 6${blocked ? ' · Awaiting inputs' : ''}` : '6 steps · At your pace';
        root.querySelector('[data-tour-back]').disabled = tourIndex <= 0;
        root.querySelector('[data-tour-next]').disabled = !playing;
        root.querySelector('[data-tour-next]').textContent = tourIndex === 5 ? 'Finish demo ✓' : 'Next step →';
        root.querySelector('[data-tour-play]').textContent = playing ? '↺ Restart' : '▶ Play demo';
        if (currentMode) {
          root.querySelector('[data-tour-play]').textContent = playing ? 'Restart stage' : 'Open requirements';
          root.querySelector('[data-tour-next]').textContent = tourIndex === 5 ? 'Finish review' : 'Next stage →';
        }
        root.querySelector('[data-tour-scene]').dataset.stage = String(tourIndex);
        stageNodes.forEach((node, index) => {
          node.classList.toggle('is-active', playing && index === tourIndex);
          node.classList.toggle('is-complete', playing && index < tourIndex);
          node.classList.remove('is-partial');
          node.querySelector('small').textContent = playing && index < tourIndex ? 'Viewed' : playing && index === tourIndex ? 'Now viewing' : 'Preview';
          node.querySelector('i').style.width = playing && index <= tourIndex ? '100%' : '0%';
          node.querySelector('button').setAttribute('aria-current', playing && index === tourIndex ? 'step' : 'false');
        });
        const math = root.querySelector('[data-tour-math]');
        math.hidden = !playing || tourIndex !== 1;
        if (!math.hidden) math.innerHTML = cooling
          ? '<math display="block"><mrow><mi>Q</mi><mo>=</mo><mover><mi>m</mi><mo>˙</mo></mover><msub><mi>c</mi><mi>p</mi></msub><mi>ΔT</mi></mrow></math><p>Heat load = mass flow × heat capacity × temperature rise</p><p>Known: 8 kW · Needed: coolant state and allowable temperature rise</p>'
          : '<math display="block"><mrow><mover><mi>m</mi><mo>˙</mo></mover><mo>=</mo><mi>ρ</mi><mi>A</mi><mi>V</mi></mrow></math><p>Mass flow = density × area × velocity</p><p>Recorded baseline: 0.010 kg/s → 6.762 m/s at the inlet</p>';
        document.dispatchEvent(new CustomEvent('aero-demo-step', { detail: { index: tourIndex, blocked } }));
      };
      const advanceTour = (index) => {
        if (!activeCase) loadCase(cases[0]);
        tourIndex = Math.max(0, Math.min(5, index));
        renderTour();
      };

      const defaults = {
        goal: 'Awaiting conversation',
        geometry: 'Awaiting dimensions or CAD',
        operating: 'Awaiting fluid inputs',
        evidence: 'Awaiting success criteria',
      };

      const appendTurn = (speaker, text) => {
        const turn = document.createElement('div');
        turn.className = `guided-turn ${speaker === 'Aero' ? 'guided-aero' : 'guided-user'}`;
        const label = document.createElement('b');
        label.textContent = speaker;
        const copy = document.createElement('p');
        copy.textContent = text;
        turn.append(label, copy);
        log.appendChild(turn);
        log.scrollTop = log.scrollHeight;
      };

      const setStages = (values = [0, 0, 0, 0, 0, 0]) => {
        stageNodes.forEach((node, index) => {
          const value = Number(values[index] || 0);
          const small = node.querySelector('small');
          const bar = node.querySelector('i');
          node.classList.toggle('is-complete', value === 100);
          node.classList.toggle('is-partial', value > 0 && value < 100);
          if (small) small.textContent = value === 100 ? 'Ready' : value > 0 ? `${value}% prepared` : index === 0 ? 'Ready for input' : 'Waiting';
          if (bar) bar.style.width = `${value}%`;
        });
      };

      const renderRecord = () => {
        const completed = Object.values(current).filter(Boolean).length;
        const value = completed * 25;
        Object.entries(defaults).forEach(([key, fallback]) => { fields[key].textContent = current[key] || fallback; });
        fields.gate.textContent = value === 100 ? 'Ready for guided review' : `Blocked / ${4 - completed} requirement ${4 - completed === 1 ? 'group' : 'groups'} missing`;
        progress.setAttribute('aria-valuenow', String(value));
        progress.querySelector('i').style.width = `${value}%`;
        progressLabel.textContent = `Requirements ${value}%`;
        continueButton.disabled = value < 100;
        if (!activeCase) setStages([value, 0, 0, 0, 0, 0]);
      };

      const answerQuestion = (message) => {
        const text = message.toLowerCase();
        if (/what.*need|missing|ready/.test(text)) {
          const missing = Object.entries(current).filter(([, value]) => !value).map(([key]) => key === 'operating' ? 'operating state' : key);
          return missing.length ? `The record still needs ${missing.join(', ')}. I will keep downstream stages blocked until those are explicit.` : 'The four requirement groups are captured. The next step is to inspect the assumptions and first-principles screen before accepting CAD or mesh work.';
        }
        if (/validat|converg/.test(text)) return 'Convergence shows the numerical procedure settled. Validation asks whether the model agrees with an independent reference. Aero tracks those as separate gates so a stable but wrong answer cannot be presented as design-ready.';
        if (/mesh/.test(text)) return 'The mesh stage needs geometry topology, boundary names, target refinements, wall treatment, and a declared independence metric. The retained nozzle example compares three grids against a 2% adjacent-grid limit.';
        if (/equation|math|first.princip|mach|continuity/.test(text)) return 'The Math stage establishes continuity, ideal-gas density, inlet velocity, Mach number, and pressure scale from declared inputs before CFD. Solver output is kept separate from these independent expectations.';
        if (/can.*run|start.*solver|openfoam/.test(text)) return 'This public demo can prepare and explain the workflow, but it cannot start the private OpenFOAM worker or VM. The execution gate stays visibly blocked outside the protected Aero instance.';
        return 'I can revise the requirement record, explain a readiness gate, or walk through the retained math, CAD, mesh, solver, and evidence. State the engineering decision or ask about a specific stage.';
      };

      const applyChange = (message) => {
        const throat = message.match(/throat(?: radius)?(?: to| =| of)?\s*(\d+(?:\.\d+)?)\s*mm/i);
        const inlet = message.match(/inlet(?: radius)?(?: to| =| of)?\s*(\d+(?:\.\d+)?)\s*mm/i);
        const exit = message.match(/exit(?: radius)?(?: to| =| of)?\s*(\d+(?:\.\d+)?)\s*mm/i);
        const mass = message.match(/(?:mass flow|ṁ)(?: to| =| of)?\s*(\d+(?:\.\d+)?)\s*(?:kg\/s|kg s-1)/i);
        const changes = [];
        if (throat) changes.push(`throat radius ${throat[1]} mm`);
        if (inlet) changes.push(`inlet radius ${inlet[1]} mm`);
        if (exit) changes.push(`exit radius ${exit[1]} mm`);
        if (mass) changes.push(`mass flow ${mass[1]} kg/s`);
        if (!changes.length) return false;
        current.geometry = [current.geometry || 'Parametric geometry', ...changes.filter((item) => !item.startsWith('mass flow'))].join(' / ');
        if (mass) current.operating = [current.operating || 'Operating state', ...changes.filter((item) => item.startsWith('mass flow'))].join(' / ');
        renderRecord();
        appendTurn('Aero', `I updated ${changes.join(' and ')}. That is a new design revision, so CAD, mesh, solve, and render must be regenerated before their prior evidence can apply.`);
        setStages([100, 100, 35, 0, 0, 0]);
        tourModified = true;
        renderTour();
        return true;
      };

      const inferCustom = (message) => {
        const lower = message.toLowerCase();
        current.goal = message.split(/[.!?]/)[0].slice(0, 150);
        if (/nozzle|throat|inlet radius|exit radius/.test(lower)) current.geometry = 'Parametric nozzle described in conversation / dimensions require confirmation';
        else if (/channel|duct|pipe|cad|geometry/.test(lower)) current.geometry = 'Flow passage described in conversation / dimensions require confirmation';
        if (/air|water|fluid|mass flow|pressure|temperature|kg\/s|kw/.test(lower)) current.operating = 'Operating information detected / units and boundary conditions require review';
        if (/percent|%|converg|validation|mesh|success|limit|within/.test(lower)) current.evidence = 'Acceptance intent detected / thresholds require confirmation';
        renderRecord();
        const missing = Object.entries(current).filter(([, value]) => !value).map(([key]) => key === 'operating' ? 'operating state' : key);
        appendTurn('Aero', missing.length ? `I started the case record. Before Math can be released, specify ${missing.join(', ')}. I will treat extracted values as proposed—not confirmed—until you approve them.` : 'I captured all four requirement groups. Review the record, then continue into the detailed walkthrough to inspect assumptions and governing equations.');
      };

      const submit = (message) => {
        const value = String(message || '').trim();
        if (!value) return;
        appendTurn('You', value);
        if (applyChange(value)) return;
        if (/^(what|why|how|can|show|explain|is|are|do)\b/i.test(value) || value.endsWith('?')) appendTurn('Aero', answerQuestion(value));
        else inferCustom(value);
      };

      const loadCase = (item) => {
        activeCase = item;
        tourIndex = -1;
        tourModified = false;
        log.replaceChildren();
        current = { ...item.requirements };
        caseLabel.textContent = item.title;
        root.querySelectorAll('[data-demo-case]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.demoCase === item.id)));
        appendTurn('You', item.prompt);
        appendTurn('Aero', `I loaded the ${item.title} walkthrough. The requirement record is complete, but each later stage keeps its own evidence gate. ${item.disposition}`);
        renderRecord();
        setStages(item.stages);
        if (input) input.value = '';
        renderTour();
      };

      const openDetail = (mode) => {
        document.getElementById('demo-evidence').open = true;
        document.getElementById('workbench')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        const tabName = mode === 'analysis' ? 'analysis' : mode === 'evidence' ? 'evidence' : 'viewport';
        document.querySelector(`.wb-tab[data-tab="${tabName}"]`)?.click();
        if (['geometry', 'mesh', 'result'].includes(mode)) document.querySelector(`.vp-mode[data-mode="${mode}"]`)?.click();
      };

      root.querySelectorAll('[data-demo-case]').forEach((button) => button.addEventListener('click', () => loadCase(cases.find((item) => item.id === button.dataset.demoCase))));
      root.querySelector('[data-new-case]')?.addEventListener('click', () => {
        activeCase = null; current = { goal: '', geometry: '', operating: '', evidence: '' };
        caseLabel.textContent = 'New case'; log.replaceChildren();
        appendTurn('Aero', 'Describe the engineering decision you need to make. I’ll separate known inputs, assumptions, missing data, success criteria, and what must remain blocked.');
        renderRecord(); input?.focus();
      });
      root.querySelectorAll('[data-guided-question]').forEach((button) => button.addEventListener('click', () => submit(button.dataset.guidedQuestion)));
      root.querySelectorAll('[data-open-detail]').forEach((button) => button.addEventListener('click', () => openDetail(button.dataset.openDetail)));
      stageNodes.forEach((node, index) => node.querySelector('button')?.addEventListener('click', () => {
        advanceTour(index);
      }));
      root.querySelector('[data-tour-play]').addEventListener('click', () => advanceTour(0));
      root.querySelector('[data-tour-back]').addEventListener('click', () => advanceTour(tourIndex - 1));
      root.querySelector('[data-tour-next]').addEventListener('click', () => {
        if (tourIndex < 5) advanceTour(tourIndex + 1);
        else {
          tourIndex = -1;
          renderTour();
          root.querySelector('[data-tour-title]').textContent = 'You’ve walked through the CFD pipeline.';
          root.querySelector('[data-tour-narration]').textContent = 'Try another example, ask a question below, or inspect the detailed evidence.';
        }
      });
      continueButton?.addEventListener('click', () => openDetail('analysis'));
      form?.addEventListener('submit', (event) => { event.preventDefault(); submit(input?.value); if (input) input.value = ''; });
      renderRecord();
      renderTour();
    })();
  </script>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-demo-library]');
      if (!root) return;
      const cases = JSON.parse(document.getElementById('demo-case-data')?.textContent || '[]');
      const buttons = [...root.querySelectorAll('[data-demo-case]')];
      const render = (item) => {
        root.querySelector('[data-demo-kind]').textContent = item.kind;
        root.querySelector('[data-demo-title]').textContent = item.title;
        root.querySelector('[data-demo-question]').textContent = item.question;
        root.querySelector('[data-demo-summary]').textContent = item.summary;
        root.querySelector('[data-demo-disposition]').textContent = item.disposition;
        const evidenceLink = root.querySelector('[data-demo-evidence]');
        evidenceLink.hidden = !item.evidenceHref;
        if (item.evidenceHref) {
          evidenceLink.href = item.evidenceHref;
          evidenceLink.firstChild.textContent = `${item.evidenceLabel} `;
        }
        root.querySelectorAll('[data-demo-stage]').forEach((stage, index) => {
          const value = Number(item.stages[index] || 0);
          const bar = stage.querySelector('.demo-progress');
          bar.setAttribute('aria-valuenow', String(value));
          bar.querySelector('i').style.width = `${value}%`;
          stage.querySelector('small').textContent = `${value}%`;
          stage.classList.toggle('is-complete', value === 100);
          stage.classList.toggle('is-partial', value > 0 && value < 100);
        });
      };
      buttons.forEach((button) => button.addEventListener('click', () => {
        const item = cases.find((candidate) => candidate.id === button.dataset.demoCase);
        if (!item) return;
        buttons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        render(item);
      }));
      render(cases[0]);
    })();
  </script>

