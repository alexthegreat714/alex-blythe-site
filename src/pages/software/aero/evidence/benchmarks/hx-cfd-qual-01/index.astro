---
import Shell from '../../../../../../components/AeroEvidenceShell.astro';
import status from '../../../../../../../public/demos/aero/hx-cfd-qual-01/status.json';

const base = '/demos/aero/hx-cfd-qual-01/';
const original = status.original;
const v7 = status.remediation_v7;
const rows = [
  ['Mesh quality', 'PASS', 'PASS'],
  ['Run completion', 'PASS', 'PASS'],
  ['Hot/cold mass conservation', 'PASS', 'PASS'],
  ['Energy conservation', 'PASS', 'PASS'],
  ['Mesh independence', 'FAIL', 'PASS'],
  ['Residual convergence', 'PASS_THRESHOLD', 'NOT_ESTABLISHED'],
  ['Monitor stability', 'NOT_ESTABLISHED', 'NOT_ESTABLISHED'],
  ['HX-03 Stage B', 'STOPPED', 'STOPPED'],
];
const visualSlides = [
  ['Outlet monitor history', 'visuals/hx_cfd_qual_01_outlet_monitors_poster.png', 'Retained shell and tube outlet-temperature telemetry through 800 s.'],
  ['Amplified ΔU · 800 s', 'visuals/flowlines/hx_cfd_qual_01_v7_flowlines_amplified_800.png', 'Amplified baseline-relative speed change at 800 s; fixed ±10% display scale, diagnostic only.'],
  ['Amplified ΔU · 400 s', 'visuals/flowlines/hx_cfd_qual_01_v7_flowlines_amplified_400.png', 'Amplified baseline-relative speed change at 400 s; fixed ±10% display scale, diagnostic only.'],
  ['Amplified ΔU · 200 s', 'visuals/flowlines/hx_cfd_qual_01_v7_flowlines_amplified_200.png', 'Amplified baseline-relative speed change at 200 s; fixed ±10% display scale, diagnostic only.'],
  ['v7 flow lines · 800 s', 'visuals/flowlines/hx_cfd_qual_01_v7_flowlines_800.png', 'Shell and tube streamlines over the retained v7 solver geometry at 800 s.'],
  ['v7 flow lines · 400 s', 'visuals/flowlines/hx_cfd_qual_01_v7_flowlines_400.png', 'Shell and tube streamlines over the retained v7 solver geometry at 400 s.'],
  ['v7 flow lines · 0 s', 'visuals/flowlines/hx_cfd_qual_01_v7_flowlines_0.png', 'Shell and tube streamlines over the retained v7 solver geometry at 0 s.'],
  ['Residual decomposition', 'visuals/v7_residual_decomposition.png', 'Residual tails by equation and fluid region.'],
  ['Transverse velocity localization', 'visuals/v7_transverse_velocity_localization.png', 'Transverse velocity q95 by axial location.'],
];
---
<Shell title="Aero · HX-CFD-QUAL-01 status" description="Original and remediation status for Aero's two-fluid manifold-aware CHT qualification. Mesh independence improved in v7; residual and monitor gates remain open." path="/software/aero/evidence/benchmarks/hx-cfd-qual-01/">
  <header>
    <p class="eyebrow">AERO / TWO-FLUID CHT QUALIFICATION</p>
    <span class="status failed">{status.status}</span>
    <h1>HX-CFD-QUAL-01: one failed run, one improved remediation.</h1>
    <p>The original qualification and its v7 remediation are shown together so the change is inspectable. v7 fixes the mesh-independence result without weakening the 1% gate, but it does not establish full numerical qualification.</p>
    <p class="metric">Decision: {status.stage_decision}</p>
    <div class="links"><a class="primary" href={base + 'REMEDIATION_V7.md'}>Read v7 remediation</a><a href={base + 'ORIGINAL_QUALIFICATION.md'}>Read original run</a><a href={base + 'status.json'}>Machine-readable status</a></div>
  </header>

  <section class="boundary" aria-labelledby="meaning-heading">
    <h2 id="meaning-heading">What this status means</h2>
    <p><strong>Real solver evidence, not a marketing pass.</strong> These are retained `chtMultiRegionFoam` fixture results with three regions: shell fluid, tube fluid and solid wall.</p>
    <p><strong>Not physical validation.</strong> The fixture uses constant/linear reference properties, has no verified CAD-to-solver identity, and has no experimental comparison in this record. A numerical gate pass does not establish design readiness.</p>
  </section>

  <section aria-labelledby="comparison-heading">
    <h2 id="comparison-heading">Original versus v7</h2>
    <div class="table-wrap"><table><thead><tr><th>Gate / quantity</th><th>Original v5</th><th>Remediation v7</th></tr></thead><tbody>{rows.map(([label, oldValue, newValue]) => <tr><th>{label}</th><td class:list={{'pass': oldValue === 'PASS' || oldValue === 'PASS_THRESHOLD', 'fail': oldValue === 'FAIL' || oldValue === 'STOPPED', 'open': oldValue === 'NOT_ESTABLISHED'}}>{oldValue}</td><td class:list={{'pass': newValue === 'PASS', 'fail': newValue === 'FAIL' || newValue === 'STOPPED', 'open': newValue === 'NOT_ESTABLISHED'}}>{newValue}</td></tr>)}</tbody></table></div>
  </section>

  <section aria-labelledby="mesh-heading">
    <h2 id="mesh-heading">The mesh result changed; the conclusion did not get inflated</h2>
    <div class="cards"><article><h3>Original v5</h3><p class="metric">{(original.max_adjacent_grid_change * 100).toFixed(3)}% maximum grid change</p><p>{original.cells.coarse.toLocaleString()} → {original.cells.medium.toLocaleString()} → {original.cells.fine.toLocaleString()} cells. The 1% mesh gate failed.</p><a href={base + 'original-mesh-independence.json'}>Inspect v5 values</a></article><article><h3>Remediation v7</h3><p class="metric">{(v7.max_adjacent_grid_change * 100).toFixed(3)}% maximum grid change</p><p>{v7.cells.coarse.toLocaleString()} → {v7.cells.medium.toLocaleString()} → {v7.cells.fine.toLocaleString()} cells. The same 1% gate passes.</p><a href={base + 'remediation-v7-mesh-independence.json'}>Inspect v7 values</a></article></div>
  </section>

  <section aria-labelledby="open-heading" class="boundary">
    <h2 id="open-heading">What remains open</h2>
    <ul><li><strong>Residual convergence:</strong> v7 fine-grid retained initial-residual window is {v7.fine_residual_max_last_window}, above the 1e-3 criterion.</li><li><strong>Monitor stability:</strong> v7 fine-grid last-window outlet-temperature drift is {v7.fine_monitor_drift_K.shell_outlet.toFixed(4)} K (shell) and {v7.fine_monitor_drift_K.tube_outlet.toFixed(4)} K (tube), above the 0.01 K criterion.</li><li><strong>Next bounded action:</strong> vary pressure-correction count and <code>p_rgh</code> relaxation one control at a time, with repaired solid-<code>e</code> telemetry. The original and v7 packages remain immutable.</li></ul>
    <p>No HX-03 Stage B work is authorized by this result. The correct public status is still <strong>FAILED_NUMERICAL_GATES</strong>.</p>
  </section>

  <section aria-labelledby="control-heading">
    <h2 id="control-heading">Solver-control diagnostic</h2>
    <p>An isolated coarse-case diagnostic changed only <code>nOuterCorrectors</code> from 1 to 2 and ran to 100 s. The maximum initial residual was 0.00144013 in the retained v7 comparison block and 0.00220704 in the control block. This did not establish an improvement, and final linear residuals were not substituted for the qualification gate.</p>
    <p><strong>DIAGNOSTIC_ONLY_NOT_QUALIFIED.</strong> The residual and monitor-stability gates remain open.</p>
  </section>

  <section aria-labelledby="visual-heading" class="boundary">
    <h2 id="visual-heading">ParaView fields and retained telemetry</h2>
    <p>Download the derived visualization package to inspect temperature, velocity, and <code>p_rgh</code> in ParaView. Each bundle contains a <code>.pvd</code> collection for the shell, tube, and solid latest-time snapshots.</p>
    <div class="links"><a class="primary" href={base + 'visuals/VISUALIZATION_MANIFEST.json'}>Visualization manifest</a><a href={base + 'visuals/VISUALIZATION_REPORT.md'}>ParaView instructions</a><a href={base + 'visuals/PRESSURE_VELOCITY_DIAGNOSTIC.md'}>Pressure / velocity diagnostic</a><a href={base + 'visuals/VISUALIZATION_SHA256SUMS.txt'}>SHA-256 checksums</a></div>
    <figure class="recording flowline-recording">
      <video controls loop muted playsinline preload="metadata" poster={base + 'visuals/flowlines/hx_cfd_qual_01_v7_flow_story_poster.png'}>
        <source src={base + 'visuals/flowlines/hx_cfd_qual_01_v7_flow_story.mp4'} type="video/mp4" />
        <img src={base + 'visuals/flowlines/hx_cfd_qual_01_flow_story.gif'} alt="Combined CFD flow story: entry reveal, retained streamlines, and enhanced thermal gradient" />
      </video>
      <figcaption><strong>Combined CFD flow story:</strong> one 15-second recording that starts empty, reveals temperature-colored flow entering from the left, keeps the retained solver-time streamlines on the same fixed 435-600 K gradient through the first ten seconds, and finishes with the retained thermal sequence. The thermal contrast is display-enhanced only; no solver data or numerical disposition is changed.</figcaption>
    </figure>
    <p class="subtle">Charts and diagnostic figures below are click-through slides. Playback is reserved for the actual 3-D flow-line views; opening a chart will never start a recording.</p>
    <div class="visual-gallery" data-evidence-gallery>
      <div class="gallery-main"><img data-gallery-main src={base + visualSlides[0][1]} alt={visualSlides[0][2]} /><p data-gallery-caption>{visualSlides[0][2]}</p></div>
      <div class="gallery-thumbs" role="list" aria-label="Evidence figures">
        {visualSlides.map(([label, src, alt], index) => <button type="button" class:list={{'gallery-thumb': true, 'is-selected': index === 0}} data-gallery-slide data-src={base + src} data-alt={alt} aria-pressed={index === 0 ? 'true' : 'false'}><img src={base + src} alt="" aria-hidden="true" /><span>{label}</span></button>)}
      </div>
    </div>
    <div class="links"><a class="primary" href={base + 'visuals/flowlines/hx_cfd_qual_01_v7_flowlines.pvd'}>Open flow lines in ParaView</a><a href={base + 'visuals/flowlines/FLOWLINE_REPORT.md'}>Flow-line report</a><a href={base + 'visuals/flowlines/FLOW_ENTRY_REPORT.md'}>Flow-entry report</a><a href={base + 'visuals/flowlines/FLOW_STORY_REPORT.md'}>Combined story report</a><a href={base + 'visuals/flowlines/FLOWLINE_MANIFEST.json'}>Flow-line manifest</a><a href={base + 'visuals/flowlines/FLOWLINE_SHA256SUMS.txt'}>Flow-line checksums</a><a href={base + 'visuals/flowlines/hx_cfd_qual_01_v7_flow_story.mp4'}>Download combined MP4</a></div>
    <div class="table-wrap"><table><thead><tr><th>Run</th><th>ParaView bundle</th><th>Additional view</th></tr></thead><tbody>
      <tr><th>Original v5 fine</th><td><a href={base + 'visuals/v5_fine_vtk.zip'}>v5_fine_vtk.zip</a></td><td rowspan="5"><a href={base + 'visuals/hx_cfd_qual_01_outlet_monitors_poster.png'}>Outlet monitor chart</a><br /><a href={base + 'visuals/v7_residual_decomposition.png'}>Residual decomposition</a><br /><a href={base + 'visuals/v7_transverse_velocity_localization.png'}>Transverse localization</a><br /><a href={base + 'visuals/flowlines/hx_cfd_qual_01_v7_flow_story.mp4'}>Combined CFD flow story</a></td></tr>
      <tr><th>v6 fine</th><td><a href={base + 'visuals/v6_fine_vtk.zip'}>v6_fine_vtk.zip</a></td></tr>
      <tr><th>Retained v7 fine</th><td><a href={base + 'visuals/v7_fine_vtk.zip'}>v7_fine_vtk.zip</a></td></tr>
      <tr><th>Unchanged continuation</th><td><a href={base + 'visuals/continuation_v1_fine_vtk.zip'}>continuation_v1_fine_vtk.zip</a></td></tr>
      <tr><th>Solver-control coarse</th><td><a href={base + 'visuals/solver_control_v1_coarse_vtk.zip'}>solver_control_v1_coarse_vtk.zip</a></td></tr>
    </tbody></table></div>
    <p class="subtle">The fields are latest-time snapshots exported from retained OpenFOAM cases. The combined recording is a presentation of those retained fields and the entry reveal; it is not a substitute for a time-resolved solver dataset. Its final segment uses the retained <code>T</code> values on a fixed 435–600 K display scale to make the gradient easier to see, without changing the solver data. The solid-equation observability repair is retained as <a href={base + 'visuals/SOLID_TELEMETRY_REPAIR.md'}>a patched-copy report</a> with <a href={base + 'visuals/solid_residuals_e_800.dat'}>numeric <code>e</code> residuals</a>.</p>
  </section>

  <section aria-labelledby="links-heading"><h2 id="links-heading">Retained local evidence</h2><p>The public files are a compact status record. The canonical evidence packages remain in the local Aero reports and retain solver logs, control dictionaries, mesh checks, monitor series and SHA-256 manifests.</p><div class="links"><a href={base + 'status.json'}>Status JSON</a><a href={base + 'REMEDIATION_V7.md'}>v7 report</a><a href={base + 'ORIGINAL_QUALIFICATION.md'}>Original report</a></div></section>
</Shell>
<script>
  const gallery = document.querySelector('[data-evidence-gallery]');
  if (gallery) {
    const main = gallery.querySelector('[data-gallery-main]');
    const caption = gallery.querySelector('[data-gallery-caption]');
    gallery.querySelectorAll('[data-gallery-slide]').forEach((button) => {
      button.addEventListener('click', () => {
        main.src = button.dataset.src || '';
        main.alt = button.dataset.alt || '';
        caption.textContent = button.dataset.alt || '';
        gallery.querySelectorAll('[data-gallery-slide]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('is-selected', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
      });
    });
  }
</script>
<style>
  .status{display:inline-block;border:1px solid currentColor;padding:5px 9px;font-size:13px;font-weight:750}.failed{color:#c84749}.links{display:flex;flex-wrap:wrap;gap:13px 20px;margin-top:18px;font-size:14px;font-weight:650}.primary{background:var(--accent);color:var(--bg);padding:10px 14px}.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.cards article{border:1px solid var(--border);background:var(--surface);padding:22px}.boundary{padding:20px;border-left:3px solid var(--accent);background:var(--surface)}.recording{margin:24px 0 20px;border:1px solid var(--border);background:var(--bg);padding:14px}.recording video{display:block;width:100%;max-height:520px;background:#071116;object-fit:contain}.recording figcaption{margin-top:10px;font-size:13px;line-height:1.5;color:var(--muted)}.visual-gallery{margin:24px 0}.gallery-main{border:1px solid var(--border);background:var(--bg);padding:14px}.gallery-main img{display:block;width:100%;max-height:520px;object-fit:contain}.gallery-main p{margin:10px 0 0;font-size:13px;color:var(--muted)}.gallery-thumbs{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}.gallery-thumb{display:flex;align-items:center;gap:8px;border:1px solid var(--border);background:var(--surface);color:inherit;padding:7px;cursor:pointer;font:inherit;text-align:left}.gallery-thumb img{width:90px;height:54px;object-fit:cover}.gallery-thumb.is-selected{border-color:var(--accent);box-shadow:inset 0 -2px var(--accent)}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:11px;border-bottom:1px solid var(--border)}th{font-weight:700}.pass{color:#26806a;font-weight:750}.fail{color:#c84749;font-weight:750}.open{color:#a66f20;font-weight:750}@media(max-width:740px){.cards{grid-template-columns:1fr}.recording{padding:8px}.gallery-thumb img{width:66px;height:42px}}
</style>
