---
import SoftwareLayout from '../../../../layouts/SoftwareLayout.astro';
import initial from '../../../../../public/demos/aero/fea-diagnostic-progress/status.json';
---
<SoftwareLayout title="AeroFEA progress" description="Public progress snapshots for the controlled 14B AeroFEA development diagnostic. Completion is separate from model quality." canonicalPath="/software/aero/progress/" hideHeader>
  <main class="tracker">
    <nav aria-label="Aero progress navigation"><a href="/software/aero/">← Aero</a><span>PUBLIC PROGRESS / 14B SPECIALIST</span></nav>
    <header><h1>AeroFEA progress</h1><p>Stock model × fine-tune. Original prompt × source-copy prompt.</p></header>
    <section class="live-card" aria-labelledby="progress-title">
      <div class="card-top"><h2 id="progress-title">Development diagnostic</h2><span id="state-pill">Checking snapshot</span></div>
      <div class="progress-numbers"><strong id="percent">{initial.percent}%</strong><span><b id="saved">{initial.saved_outputs}</b> / 192 outputs saved</span></div>
      <div class="bar" id="progress-bar" role="progressbar" aria-label="Saved diagnostic outputs" aria-valuemin="0" aria-valuemax="192" aria-valuenow={initial.saved_outputs}><span id="bar-fill" style={`width:${initial.percent}%`}></span></div>
      <div class="activity" role="status" aria-live="polite"><span id="spinner" class="spinner" hidden aria-hidden="true"></span><strong id="activity-text">Reading the latest public snapshot…</strong></div>
      <p id="phase-text" class="small">Four separate cells, 48 outputs each.</p>
      <p class="freshness" id="freshness">Last checked: {initial.observed_at || 'not available'}</p>
      <div class="card-bottom"><span id="gate-text">Gate status pending</span><button id="refresh" type="button">Refresh snapshot ↻</button></div>
    </section>
    <p class="snapshot-note">Published snapshots update about every <strong>15 minutes</strong> while the observer is online. This page checks for a newer snapshot every 30 seconds. An animated indicator reflects a recent verified check—not continuous telemetry or proof of learning.</p>
    <section aria-labelledby="cells-title"><h2 id="cells-title">The four matched cells</h2><div id="cells" class="cells">{initial.phases.map(p=><article data-phase={p.id}><div><h3>{p.label}</h3><span data-phase-state>{p.state.replaceAll('_',' ')}</span></div><strong data-phase-count>{p.saved} / {p.total}</strong><progress value={p.saved} max={48} aria-label={`${p.label} saved outputs`}></progress></article>)}</div></section>
    <section class="meaning" aria-labelledby="meaning-title"><h2 id="meaning-title">What this percentage means</h2><p><strong>100% means the 192 responses were saved.</strong> It does not mean the model passed evaluation, became more capable, or was approved for engineering use.</p><div class="facts"><div><span>Training</span><strong>14B candidate trained · 858 steps</strong><small>This is inference, not another training run.</small></div><div><span>Quality review</span><strong>Not established for this diagnostic</strong><small>Raw results and deterministic guard corrections will be reported separately.</small></div><div><span>Promotion</span><strong>Not authorized</strong><small>One synthetic development repeat is not fresh heldout confirmation.</small></div></div></section>
    <details><summary>Method and limitations</summary><p>The same 48 synthetic engineering requests are evaluated in four fresh processes: stock Qwen2.5-14B-Instruct and its trained AeroFEA adapter, each with the original and explicit source-copy prompt. This tests material-identity copying, null handling and schema behavior—not CFD or FEA solver accuracy. Errors and missing outputs remain failures or incomplete evidence.</p><p>Model loading and the startup CUDA check do not count as saved responses. A live process or warm GPU alone does not establish useful progress. A stale observation stops the activity indicator; it does not prove the worker stopped or is looping.</p><a href="/demos/aero/fea-diagnostic-progress/status.json">Sanitized machine-readable snapshot →</a><p>Private logs, prompts, model responses, case identifiers, machine addresses, process IDs and filesystem paths are not published.</p></details>
    <footer><a href="/software/aero/evidence/reports/specialist-pipeline-2026-10-10/">Earlier specialist evidence →</a><p>Personal project · no employer data. Historical results remain separate.</p></footer>
  </main>
</SoftwareLayout>
<script>
  import initial from '../../../../../public/demos/aero/fea-diagnostic-progress/status.json';
  const endpoint='/demos/aero/fea-diagnostic-progress/status.json';
  const el=(id:string)=>document.getElementById(id)!;
  let snapshot=initial;
  let failedFetch=false;
  const labels:Record<string,string>={MODEL_LOADING:'Loading model',RUNNING:'Running at last check',STARTUP_CHECK:'Startup check',OUTPUTS_SAVED_SCORING_PENDING:'Outputs saved · review pending',INCOMPLETE_STOPPED:'Stopped · incomplete',OBSERVATION_STALE:'Observation stale',NOT_ESTABLISHED:'Not established'};
  function render(){
    const s=snapshot;
    const observed=Date.parse(s.observed_at||'');
    const age=Number.isFinite(observed)?Math.max(0,(Date.now()-observed)/1000):Infinity;
    const recent=age<=90 && s.snapshot_source_fresh && !failedFetch;
    const stopped=s.state==='INCOMPLETE_STOPPED';
    const animate=recent && !stopped && !s.collection_complete && ['recent_output_progress','model_loading'].includes(s.activity_at_observation);
    el('percent').textContent=`${s.percent}%`;
    el('saved').textContent=String(s.saved_outputs);
    el('bar-fill').style.width=`${s.percent}%`;
    el('progress-bar').setAttribute('aria-valuenow',String(s.saved_outputs));
    el('state-pill').textContent=failedFetch?'Refresh unavailable':s.collection_complete?labels[s.state]:age>20*60?'Snapshot stale':labels[s.state]||'Not established';
    el('spinner').hidden=!animate;
    el('activity-text').textContent=failedFetch?'Could not refresh; showing the last known snapshot.':s.collection_complete?'Response collection finished. Scoring and review are separate.':stopped?'The diagnostic stopped; saved outputs are retained.':!recent?'No fresh liveness check. Do not infer that the worker stopped.':s.activity_at_observation==='recent_output_progress'?'Recent saved-output progress verified.':s.activity_at_observation==='model_loading'?'Model loading verified at the last check.':'Worker observed; no recent output change verified.';
    const phase=s.phases.find(p=>p.id===s.active_phase);
    el('phase-text').textContent=phase?`Current cell: ${phase.label}.`:'Four separate cells, 48 outputs each.';
    el('freshness').textContent=Number.isFinite(observed)?`Last execution check: ${new Date(observed).toLocaleString()} · ${age<60?`${Math.floor(age)} sec`:`${Math.floor(age/60)} min`} ago`:'Execution check not available';
    el('gate-text').textContent=s.gate_breach_count?`${s.gate_breach_count} gate breach(es) recorded`:'No gate breaches in the published observation';
    for(const p of s.phases){
      const card=document.querySelector(`[data-phase="${p.id}"]`)!;
      card.querySelector('[data-phase-state]')!.textContent=p.state.replaceAll('_',' ');
      card.querySelector('[data-phase-count]')!.textContent=`${p.saved} / 48`;
      card.querySelector('progress')!.value=p.saved;
    }
  }
  async function refresh(){
    const button=el('refresh') as HTMLButtonElement;
    if(button.disabled)return;
    button.disabled=true;
    try{
      const response=await fetch(`${endpoint}?t=${Date.now()}`,{cache:'no-store',credentials:'omit',signal:AbortSignal.timeout(10000)});
      if(!response.ok)throw new Error('Snapshot unavailable');
      const s=await response.json();
      if(s.schema!=='aero.public.fea.progress.v1'||s.total_outputs!==192||!Number.isInteger(s.saved_outputs)||s.saved_outputs<0||s.saved_outputs>192||!Array.isArray(s.phases)||s.phases.length!==4||s.phases.some((p:any,i:number)=>p.id!==initial.phases[i].id||!Number.isInteger(p.saved)||p.saved<0||p.saved>48))throw new Error('Invalid snapshot');
      snapshot=s;failedFetch=false;
    }catch{failedFetch=true;}finally{button.disabled=false;render();}
  }
  el('refresh').addEventListener('click',refresh);
  render();refresh();
  setInterval(refresh,30000);
  setInterval(render,1000);
</script>
<style>
  :global(body){background:#090f19;color:#e5edf8}.tracker{--ink:#e5edf8;--dim:#a4b4c9;--line:#293b52;--aqua:#81e2ca;max-width:980px;margin:auto;padding:18px 22px 50px;color:var(--ink);font-family:system-ui,sans-serif}.tracker nav{display:flex;justify-content:space-between;gap:16px;align-items:center;font-size:12px}.tracker nav span{font-size:10px;color:var(--dim);letter-spacing:.1em}.tracker a{color:var(--aqua)}header{padding:22px 0 16px}header h1{font-size:clamp(28px,5vw,44px);line-height:1.1;margin:0 0 8px}header p{font-size:14px;color:var(--dim);margin:0}.live-card{padding:24px;border:1px solid #4e8d86;border-radius:16px;background:linear-gradient(135deg,#142536,#102020)}.card-top,.card-bottom{display:flex;justify-content:space-between;align-items:center;gap:14px}.card-top h2{font-size:16px;margin:0}.card-top>span{font-size:11px;border:1px solid var(--line);border-radius:30px;padding:6px 9px;color:var(--aqua)}.progress-numbers{display:flex;align-items:baseline;gap:18px;margin:18px 0 8px}.progress-numbers>strong{font-size:clamp(48px,9vw,78px);line-height:1;letter-spacing:-.06em}.progress-numbers>span{font-size:15px;color:var(--dim)}.bar{height:15px;background:#26374b;border-radius:20px;overflow:hidden}.bar>span{display:block;height:100%;background:var(--aqua);border-radius:20px;transition:width .4s}.activity{display:flex;align-items:center;gap:10px;min-height:50px;margin-top:12px;font-size:14px}.spinner{flex:none;width:20px;height:20px;border:3px solid #3b5961;border-top-color:var(--aqua);border-radius:50%;animation:spin 1s linear infinite}.spinner[hidden]{display:none}.small,.freshness{color:var(--dim);font-size:12px;margin:5px 0}.card-bottom{border-top:1px solid var(--line);padding-top:12px;margin-top:16px;font-size:11px;color:var(--dim)}button{font:inherit;cursor:pointer;border:1px solid #4d736d;background:transparent;border-radius:7px;color:var(--aqua);padding:9px 12px;min-height:40px}button:disabled{opacity:.5}.snapshot-note{font-size:12px;color:var(--dim);line-height:1.6;max-width:780px;margin:16px 0 26px}.tracker section:not(.live-card){margin-top:28px}.tracker section>h2{font-size:20px;margin-bottom:14px}.cells{display:grid;grid-template-columns:1fr 1fr;gap:12px}.cells article{padding:16px;border:1px solid var(--line);border-radius:10px;background:#111c2b}.cells article>div{display:flex;align-items:start;justify-content:space-between;gap:10px}.cells h3{font-size:14px;margin:0}.cells article span{font-size:10px;text-transform:uppercase;color:var(--dim)}.cells article>strong{display:block;font-size:22px;margin:14px 0 8px}.cells progress{width:100%;height:8px;accent-color:var(--aqua)}.meaning p,details p,footer p{font-size:13px;color:var(--dim);line-height:1.65}.meaning p strong{color:var(--ink)}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:18px 0}.facts div{display:flex;flex-direction:column;gap:9px;padding:15px;background:#111c2b;border-left:2px solid #4d736d}.facts span{font-size:11px;color:var(--aqua);text-transform:uppercase}.facts strong{font-size:13px}.facts small{font-size:11px;line-height:1.5;color:var(--dim)}details{margin-top:28px;border-top:1px solid var(--line);padding-top:18px}summary{cursor:pointer;font-size:14px}details a{font-size:13px}footer{margin-top:30px;border-top:1px solid var(--line);padding-top:18px;font-size:13px}.tracker :is(a,button,summary):focus-visible{outline:2px solid var(--aqua);outline-offset:4px}@keyframes spin{to{transform:rotate(360deg)}}@media(prefers-reduced-motion:reduce){.spinner{animation:none}.bar>span{transition:none}}@media(max-width:600px){.tracker{padding:12px 16px 32px}header{padding:15px 0 13px}.live-card{padding:17px}.card-top{align-items:start}.card-top h2{max-width:130px;font-size:14px}.card-top>span{max-width:140px}.progress-numbers{gap:14px}.progress-numbers>span{font-size:12px}.activity{font-size:12px;min-height:44px}.card-bottom{align-items:start;flex-direction:column;gap:10px}.cells,.facts{grid-template-columns:1fr}.tracker nav span{font-size:8px}.snapshot-note{font-size:11px}}
</style>
