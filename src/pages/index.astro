  .research-meta { display: flex; gap: 18px; color: #9daaa6; font-family: "SFMono-Regular", Consolas, monospace; font-size: .62rem; text-transform: uppercase; }
  .research-meta span:last-child { margin-left: auto; color: #df835d; font-size: .95rem; }
