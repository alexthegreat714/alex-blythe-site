---
const destination = '/#resume';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href="https://alex-blythe.com/" />
    <title>Resume — Alex Blythe</title>
    <script is:inline define:vars={{ destination }}>window.location.replace(destination);</script>
  </head>
  <body><p>This page has moved to the <a href={destination}>current résumé summary</a>.</p></body>
</html>
