---
import SoftwareLayout from '../layouts/SoftwareLayout.astro';
const {title,description,path}=Astro.props;
---
<SoftwareLayout title={title} description={description} canonicalPath={path} hideHeader>
<div class="evidence-shell"><nav aria-label="Aero public navigation" class="evidence-nav"><a href="/software/aero/current/">Try Aero</a><a href="/software/aero/evidence/">See the evidence</a><a href="/software/aero/evidence/#artifacts">Technical papers / artifacts</a></nav><slot/><footer><a href="/software/aero/">← Aero overview</a><p>Personal project; not affiliated with or endorsed by any employer. Do not submit controlled or proprietary data.</p></footer></div>
</SoftwareLayout>
<style is:global>
.evidence-shell{max-width:1160px;margin:auto;padding:22px 22px 45px;font-size:16px}.evidence-nav{display:flex;flex-wrap:wrap;gap:15px 25px;font-size:14px;border-bottom:1px solid var(--border);padding-bottom:20px}.evidence-nav::after{content:'Alex Blythe · Aero study / benchmark record · Updated September 17, 2026';flex-basis:100%;color:var(--muted);font-family:"SFMono-Regular",Consolas,monospace;font-size:11px;letter-spacing:.045em;text-transform:uppercase}.evidence-shell h1{font-size:clamp(30px,4vw,46px);line-height:1.1;margin:16px 0}.evidence-shell h2{font-size:clamp(24px,3vw,30px);line-height:1.15}.evidence-shell h3{font-size:21px;line-height:1.2}.evidence-shell p,.evidence-shell li{line-height:1.65;color:var(--muted)}.evidence-shell .eyebrow{font-size:12px;letter-spacing:.1em;color:var(--accent);font-weight:800}.evidence-shell header{padding:25px 0 16px}.evidence-shell header p{max-width:850px}.evidence-shell section{scroll-margin-top:20px;margin:32px 0}.evidence-shell .filters{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0}.evidence-shell button{font:inherit;font-size:14px;background:var(--surface);border:1px solid var(--border);color:var(--text);padding:8px 12px;cursor:pointer}.evidence-shell button[aria-pressed=true]{border-color:var(--accent);box-shadow:inset 0 -2px var(--accent)}.evidence-shell .cards{display:grid;grid-template-columns:1fr 1fr;gap:18px}.evidence-shell article{border:1px solid var(--border);background:var(--surface);padding:22px;min-width:0}.evidence-shell article[hidden]{display:none}.evidence-shell .status{display:inline-block;border:1px solid currentColor;padding:5px 9px;font-size:13px;font-weight:750}.evidence-shell .mixed{color:var(--accent)}.evidence-shell .failed{color:#c84749}.evidence-shell .bounded{color:#26806a}.evidence-shell .pending{color:var(--muted)}:root[data-theme=dark] .evidence-shell .failed{color:#f69b96}:root[data-theme=dark] .evidence-shell .bounded{color:#7dd4b7}.evidence-shell .metric{font-size:21px;font-weight:750;color:var(--text);line-height:1.3}.evidence-shell .links{display:flex;flex-wrap:wrap;gap:13px 20px;margin-top:18px;font-size:14px;font-weight:650}.evidence-shell .primary{background:var(--accent);color:var(--bg);padding:10px 14px}.evidence-shell details{border-top:1px solid var(--border);margin-top:20px;padding-top:15px}.evidence-shell summary{cursor:pointer;font-size:14px;font-weight:700}.evidence-shell .boundary{padding:20px;border-left:3px solid var(--accent);background:var(--surface)}.evidence-shell .table-wrap{overflow:auto}.evidence-shell table{border-collapse:collapse;width:100%;font-size:14px}.evidence-shell th,.evidence-shell td{padding:11px 8px;text-align:left;border-bottom:1px solid var(--border)}.evidence-shell code{overflow-wrap:anywhere;font-size:13px}.evidence-shell .timeline{display:grid;grid-template-columns:repeat(6,1fr);padding:0;list-style:none;gap:10px}.evidence-shell .timeline li{padding:12px;background:var(--surface);border:1px solid var(--border);font-size:14px}.evidence-shell .timeline span{display:block;font-size:12px}.evidence-shell footer{border-top:1px solid var(--border);padding-top:25px;margin-top:35px;font-size:14px}.evidence-shell .subtle{font-size:13px}.evidence-shell a:focus-visible,.evidence-shell button:focus-visible,.evidence-shell summary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(max-width:740px){.evidence-shell .cards{grid-template-columns:1fr}.evidence-shell .timeline{grid-template-columns:1fr 1fr}.evidence-shell{padding:15px}.evidence-shell article{padding:17px}}
</style>
