{
    admin off
}

:5322 {
    @study path /study/health /study/brief /study/runs /study/runs/* /study/cooling/brief /study/cooling/runs
    handle @study {
        request_body {
            max_size 2KB
        }
        reverse_proxy study-api:5323 {
            header_up X-Aero-Client-IP {http.request.header.CF-Connecting-IP}
            transport http {
                max_conns_per_host 8
                response_header_timeout 12s
            }
        }
    }

    @health path /health
    handle @health {
        reverse_proxy conversation:5320 {
            transport http {
                max_conns_per_host 8
                response_header_timeout 8s
            }
        }
    }

    @chat path /chat
    handle @chat {
        request_body {
            max_size 32KB
        }
        reverse_proxy conversation:5320 {
            # The Cloudflare tunnel supplies CF-Connecting-IP. Never trust a
            # browser-supplied X-Aero-Client-IP header for the gateway quota.
            header_up X-Aero-Client-IP {http.request.header.CF-Connecting-IP}
            transport http {
                max_conns_per_host 8
                response_header_timeout 120s
            }
        }
    }

    handle {
        respond 404
    }
}
